    "Consultar y Registrar Caducidades": {
      "main": [
        [
          {
            "node": "WhatsApp Matriz Resumen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "WhatsApp Matriz Resumen": {
      "main": [
        [
          {
            "node": "Actualizar BD a Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
