<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="LowStockDataSource">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString>/* Local Connection */</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>d1b2c3d4-e5f6-7890-abcd-ef1234567890</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSetHeader">
      <Query>
        <DataSourceName>LowStockDataSource</DataSourceName>
        <CommandText>/* Local Query */</CommandText>
      </Query>
      <Fields>
        <Field Name="CompanyName"><DataField>CompanyName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CompanyRuc"><DataField>CompanyRuc</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CompanyAddress"><DataField>CompanyAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CompanyPhone"><DataField>CompanyPhone</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="WarehouseId"><DataField>WarehouseId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="WarehouseName"><DataField>WarehouseName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="WarehouseAddress"><DataField>WarehouseAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="GeneratedAt"><DataField>GeneratedAt</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ActiveThreshold"><DataField>ActiveThreshold</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="TotalCriticalCount"><DataField>TotalCriticalCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="TotalWarningCount"><DataField>TotalWarningCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="TotalAlertCount"><DataField>TotalAlertCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="GeneratedBy"><DataField>GeneratedBy</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSetItems">
      <Query>
        <DataSourceName>LowStockDataSource</DataSourceName>
        <CommandText>/* Local Query */</CommandText>
      </Query>
      <Fields>
        <Field Name="ItemIndex"><DataField>ItemIndex</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="ProductCode"><DataField>ProductCode</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ProductName"><DataField>ProductName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CategoryName"><DataField>CategoryName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CurrentStock"><DataField>CurrentStock</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="Threshold"><DataField>Threshold</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="DeficitQuantity"><DataField>DeficitQuantity</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="SuggestedPrice"><DataField>SuggestedPrice</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="AlertLevel"><DataField>AlertLevel</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="NearestExpirationDate"><DataField>NearestExpirationDate</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <Body>
    <ReportItems>
      <!-- ==================== ENCABEZADO SUPERIOR IZQUIERDO ==================== -->
      <Textbox Name="TxtEmpresaTitulo">
        <Top>0.4cm</Top>
        <Left>0.5cm</Left>
        <Height>0.7cm</Height>
        <Width>12.0cm</Width>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=First(Fields!CompanyName.Value, "DataSetHeader")</Value>
                <Style>
                  <FontFamily>Arial</FontFamily>
                  <FontSize>15pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
        </Paragraphs>
      </Textbox>
      <Textbox Name="TxtEmpresaDireccion">
        <Top>1.15cm</Top>
        <Left>0.5cm</Left>
        <Height>0.4cm</Height>
        <Width>12.0cm</Width>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>=First(Fields!CompanyAddress.Value, "DataSetHeader")</Value>
                <Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><Color>#333333</Color></Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
        </Paragraphs>
      </Textbox>
      <Textbox Name="TxtEmpresaTelf">
        <Top>1.6cm</Top>
        <Left>0.5cm</Left>
        <Height>0.4cm</Height>
        <Width>12.0cm</Width>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="Telf: " &amp; First(Fields!CompanyPhone.Value, "DataSetHeader") &amp; "  |  R.U.C.: " &amp; First(Fields!CompanyRuc.Value, "DataSetHeader")</Value>
                <Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><Color>#333333</Color></Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
        </Paragraphs>
      </Textbox>

      <!-- ==================== RECUADRO SUPERIOR DERECHO (TÍTULO DE REPORTE) ==================== -->
      <Rectangle Name="RectTituloReporte">
        <Top>0.4cm</Top>
        <Left>13.2cm</Left>
        <Height>1.8cm</Height>
        <Width>6.8cm</Width>
        <Style>
          <Border><Style>Solid</Style><Color>#000000</Color><Width>1.5pt</Width></Border>
        </Style>
        <ReportItems>
          <Textbox Name="TxtAlertaTag">
            <Top>0.15cm</Top>
            <Left>0.2cm</Left>
            <Height>0.45cm</Height>
            <Width>6.4cm</Width>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>CONTROL DE INVENTARIO</Value>
                    <Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#555555</Color></Style>
                  </TextRun>
                </TextRuns>
                <Style><TextAlign>Center</TextAlign></Style>
              </Paragraph>
            </Paragraphs>
          </Textbox>
          <Rectangle Name="RectBarraGris">
            <Top>0.65cm</Top>
            <Left>0.2cm</Left>
            <Height>0.55cm</Height>
            <Width>6.4cm</Width>
            <Style><BackgroundColor>#F0F2F5</BackgroundColor></Style>
            <ReportItems>
              <Textbox Name="TxtSubAlerta">
                <Top>0.05cm</Top>
                <Left>0.1cm</Left>
                <Height>0.45cm</Height>
                <Width>6.2cm</Width>
                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>ALERTA DE BAJO STOCK</Value>
                        <Style><FontFamily>Arial</FontFamily><FontSize>9.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#C0392B</Color></Style>
                      </TextRun>
                    </TextRuns>
                    <Style><TextAlign>Center</TextAlign></Style>
                  </Paragraph>
                </Paragraphs>
              </Textbox>
            </ReportItems>
          </Rectangle>
          <Textbox Name="TxtFechaHoraTop">
            <Top>1.25cm</Top>
            <Left>0.2cm</Left>
            <Height>0.45cm</Height>
            <Width>6.4cm</Width>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=First(Fields!GeneratedAt.Value, "DataSetHeader")</Value>
                    <Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style>
                  </TextRun>
                </TextRuns>
                <Style><TextAlign>Center</TextAlign></Style>
              </Paragraph>
            </Paragraphs>
          </Textbox>
        </ReportItems>
      </Rectangle>

      <!-- ==================== RECUADRO DE DATOS DE LA SUCURSAL ==================== -->
      <Rectangle Name="RectDatosSucursal">
        <Top>2.4cm</Top>
        <Left>0.5cm</Left>
        <Height>1.3cm</Height>
        <Width>19.5cm</Width>
        <Style>
          <Border><Style>Solid</Style><Color>#E0E0E0</Color><Width>1pt</Width></Border>
        </Style>
        <ReportItems>
          <!-- Fila 1: Sucursal y Umbral -->
          <Textbox Name="LblSucursal">
            <Top>0.15cm</Top>
            <Left>0.3cm</Left>
            <Height>0.45cm</Height>
            <Width>3.0cm</Width>
            <Paragraphs><Paragraph><TextRuns><TextRun><Value>Sucursal / Almacén:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
          </Textbox>
          <Textbox Name="ValSucursal">
            <Top>0.15cm</Top>
            <Left>3.3cm</Left>
            <Height>0.45cm</Height>
            <Width>8.5cm</Width>
            <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!WarehouseName.Value, "DataSetHeader")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#0066A1</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
          </Textbox>

          <Textbox Name="LblUmbral">
            <Top>0.15cm</Top>
            <Left>12.0cm</Left>
            <Height>0.45cm</Height>
            <Width>3.2cm</Width>
            <Paragraphs><Paragraph><TextRuns><TextRun><Value>Umbral de Alerta:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
          </Textbox>
          <Textbox Name="ValUmbral">
            <Top>0.15cm</Top>
            <Left>15.2cm</Left>
            <Height>0.45cm</Height>
            <Width>4.0cm</Width>
            <Paragraphs><Paragraph><TextRuns><TextRun><Value>="&lt;= " &amp; CStr(First(Fields!ActiveThreshold.Value, "DataSetHeader")) &amp; " unidades"</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#D35400</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
          </Textbox>

          <!-- Fila 2: Dirección y Responsable -->
          <Textbox Name="LblDireccion">
            <Top>0.65cm</Top>
            <Left>0.3cm</Left>
            <Height>0.45cm</Height>
            <Width>3.0cm</Width>
            <Paragraphs><Paragraph><TextRuns><TextRun><Value>Ubicación / Dirección:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
          </Textbox>
          <Textbox Name="ValDireccion">
            <Top>0.65cm</Top>
            <Left>3.3cm</Left>
            <Height>0.45cm</Height>
            <Width>8.5cm</Width>
            <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!WarehouseAddress.Value, "DataSetHeader")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs>
          </Textbox>

          <Textbox Name="LblGeneradoPor">
            <Top>0.65cm</Top>
            <Left>12.0cm</Left>
            <Height>0.45cm</Height>
            <Width>3.2cm</Width>
            <Paragraphs><Paragraph><TextRuns><TextRun><Value>Generado por:</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
          </Textbox>
          <Textbox Name="ValGeneradoPor">
            <Top>0.65cm</Top>
            <Left>15.2cm</Left>
            <Height>0.45cm</Height>
            <Width>4.0cm</Width>
            <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!GeneratedBy.Value, "DataSetHeader")</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs>
          </Textbox>
        </ReportItems>
      </Rectangle>

      <!-- ==================== TARJETAS DE RESUMEN (KPIs) ==================== -->
      <!-- Card 1: Total Alertas -->
      <Rectangle Name="CardTotalAlertas">
        <Top>3.9cm</Top>
        <Left>0.5cm</Left>
        <Height>1.0cm</Height>
        <Width>6.2cm</Width>
        <Style><BackgroundColor>#F4F8FA</BackgroundColor><Border><Style>Solid</Style><Color>#BCE8F1</Color><Width>1pt</Width></Border></Style>
        <ReportItems>
          <Textbox Name="TxtKpiTotalLbl">
            <Top>0.1cm</Top><Left>0.2cm</Left><Height>0.35cm</Height><Width>5.8cm</Width>
            <Paragraphs><Paragraph><TextRuns><TextRun><Value>TOTAL PRODUCTOS EN ALERTA</Value><Style><FontFamily>Arial</FontFamily><FontSize>7pt</FontSize><FontWeight>Bold</FontWeight><Color>#31708F</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
          </Textbox>
          <Textbox Name="TxtKpiTotalVal">
            <Top>0.45cm</Top><Left>0.2cm</Left><Height>0.45cm</Height><Width>5.8cm</Width>
            <Paragraphs><Paragraph><TextRuns><TextRun><Value>=CStr(First(Fields!TotalAlertCount.Value, "DataSetHeader")) &amp; " Ítems"</Value><Style><FontFamily>Arial</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#0066A1</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
          </Textbox>
        </ReportItems>
      </Rectangle>

      <!-- Card 2: Agotados (Stock = 0) -->
      <Rectangle Name="CardAgotados">
        <Top>3.9cm</Top>
        <Left>7.15cm</Left>
        <Height>1.0cm</Height>
        <Width>6.2cm</Width>
        <Style><BackgroundColor>#FDEDEC</BackgroundColor><Border><Style>Solid</Style><Color>#F5B7B1</Color><Width>1pt</Width></Border></Style>
        <ReportItems>
          <Textbox Name="TxtKpiCriticosLbl">
            <Top>0.1cm</Top><Left>0.2cm</Left><Height>0.35cm</Height><Width>5.8cm</Width>
            <Paragraphs><Paragraph><TextRuns><TextRun><Value>QUIEBRE TOTAL (STOCK CERO)</Value><Style><FontFamily>Arial</FontFamily><FontSize>7pt</FontSize><FontWeight>Bold</FontWeight><Color>#C0392B</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
          </Textbox>
          <Textbox Name="TxtKpiCriticosVal">
            <Top>0.45cm</Top><Left>0.2cm</Left><Height>0.45cm</Height><Width>5.8cm</Width>
            <Paragraphs><Paragraph><TextRuns><TextRun><Value>=CStr(First(Fields!TotalCriticalCount.Value, "DataSetHeader")) &amp; " Ítems"</Value><Style><FontFamily>Arial</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#C0392B</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
          </Textbox>
        </ReportItems>
      </Rectangle>

      <!-- Card 3: Stock Crítico (>0 y <= umbral) -->
      <Rectangle Name="CardCriticos">
        <Top>3.9cm</Top>
        <Left>13.8cm</Left>
        <Height>1.0cm</Height>
        <Width>6.2cm</Width>
        <Style><BackgroundColor>#FEF5E7</BackgroundColor><Border><Style>Solid</Style><Color>#FAD7A0</Color><Width>1pt</Width></Border></Style>
        <ReportItems>
          <Textbox Name="TxtKpiWarningLbl">
            <Top>0.1cm</Top><Left>0.2cm</Left><Height>0.35cm</Height><Width>5.8cm</Width>
            <Paragraphs><Paragraph><TextRuns><TextRun><Value>STOCK POR AGOTARSE</Value><Style><FontFamily>Arial</FontFamily><FontSize>7pt</FontSize><FontWeight>Bold</FontWeight><Color>#D35400</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
          </Textbox>
          <Textbox Name="TxtKpiWarningVal">
            <Top>0.45cm</Top><Left>0.2cm</Left><Height>0.45cm</Height><Width>5.8cm</Width>
            <Paragraphs><Paragraph><TextRuns><TextRun><Value>=CStr(First(Fields!TotalWarningCount.Value, "DataSetHeader")) &amp; " Ítems"</Value><Style><FontFamily>Arial</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#D35400</Color></Style></TextRun></TextRuns></Paragraph></Paragraphs>
          </Textbox>
        </ReportItems>
      </Rectangle>

      <!-- ==================== TABLA DETALLADA DE PRODUCTOS ==================== -->
      <Tablix Name="TablixLowStock">
        <Top>5.2cm</Top>
        <Left>0.5cm</Left>
        <Height>1.2cm</Height>
        <Width>19.5cm</Width>
        <DataSetName>DataSetItems</DataSetName>
        <TablixBody>
          <TablixColumns>
            <TablixColumn><Width>0.8cm</Width></TablixColumn>
            <TablixColumn><Width>2.2cm</Width></TablixColumn>
            <TablixColumn><Width>6.0cm</Width></TablixColumn>
            <TablixColumn><Width>3.1cm</Width></TablixColumn>
            <TablixColumn><Width>1.8cm</Width></TablixColumn>
            <TablixColumn><Width>1.8cm</Width></TablixColumn>
            <TablixColumn><Width>1.8cm</Width></TablixColumn>
            <TablixColumn><Width>2.0cm</Width></TablixColumn>
          </TablixColumns>
          <TablixRows>
            <!-- FILA ENCABEZADO (CON LÍNEA NEGRA ARRIBA Y ABAJO) -->
            <TablixRow>
              <Height>0.6cm</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ColNum">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>#</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style>
                        <TopBorder><Style>Solid</Style><Color>#000000</Color><Width>1.5pt</Width></TopBorder>
                        <BottomBorder><Style>Solid</Style><Color>#000000</Color><Width>1.5pt</Width></BottomBorder>
                        <PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ColCodigo">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>CÓDIGO</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style>
                        <TopBorder><Style>Solid</Style><Color>#000000</Color><Width>1.5pt</Width></TopBorder>
                        <BottomBorder><Style>Solid</Style><Color>#000000</Color><Width>1.5pt</Width></BottomBorder>
                        <PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ColProducto">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>PRODUCTO</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style>
                        <TopBorder><Style>Solid</Style><Color>#000000</Color><Width>1.5pt</Width></TopBorder>
                        <BottomBorder><Style>Solid</Style><Color>#000000</Color><Width>1.5pt</Width></BottomBorder>
                        <PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ColCategoria">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>CATEGORÍA</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style>
                        <TopBorder><Style>Solid</Style><Color>#000000</Color><Width>1.5pt</Width></TopBorder>
                        <BottomBorder><Style>Solid</Style><Color>#000000</Color><Width>1.5pt</Width></BottomBorder>
                        <PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ColStock">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>STOCK</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                      <Style>
                        <TopBorder><Style>Solid</Style><Color>#000000</Color><Width>1.5pt</Width></TopBorder>
                        <BottomBorder><Style>Solid</Style><Color>#000000</Color><Width>1.5pt</Width></BottomBorder>
                        <PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><PaddingRight>3pt</PaddingRight>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ColUmbral">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>UMBRAL</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                      <Style>
                        <TopBorder><Style>Solid</Style><Color>#000000</Color><Width>1.5pt</Width></TopBorder>
                        <BottomBorder><Style>Solid</Style><Color>#000000</Color><Width>1.5pt</Width></BottomBorder>
                        <PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><PaddingRight>3pt</PaddingRight>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ColFaltante">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>FALTANTE</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                      <Style>
                        <TopBorder><Style>Solid</Style><Color>#000000</Color><Width>1.5pt</Width></TopBorder>
                        <BottomBorder><Style>Solid</Style><Color>#000000</Color><Width>1.5pt</Width></BottomBorder>
                        <PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><PaddingRight>3pt</PaddingRight>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ColEstado">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>ESTADO</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style>
                        <TopBorder><Style>Solid</Style><Color>#000000</Color><Width>1.5pt</Width></TopBorder>
                        <BottomBorder><Style>Solid</Style><Color>#000000</Color><Width>1.5pt</Width></BottomBorder>
                        <PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>
            <!-- FILA DATOS -->
            <TablixRow>
              <Height>0.6cm</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="CellNum">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ItemIndex.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style>
                        <BottomBorder><Style>Solid</Style><Color>#EAEAEA</Color><Width>0.5pt</Width></BottomBorder>
                        <PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="CellCodigo">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ProductCode.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style>
                        <BottomBorder><Style>Solid</Style><Color>#EAEAEA</Color><Width>0.5pt</Width></BottomBorder>
                        <PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="CellProducto">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ProductName.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style>
                        <BottomBorder><Style>Solid</Style><Color>#EAEAEA</Color><Width>0.5pt</Width></BottomBorder>
                        <PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="CellCategoria">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!CategoryName.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns></Paragraph></Paragraphs>
                      <Style>
                        <BottomBorder><Style>Solid</Style><Color>#EAEAEA</Color><Width>0.5pt</Width></BottomBorder>
                        <PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="CellStock">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=CStr(Fields!CurrentStock.Value)</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>=IIf(Fields!CurrentStock.Value = 0, "#C0392B", "#D35400")</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                      <Style>
                        <BottomBorder><Style>Solid</Style><Color>#EAEAEA</Color><Width>0.5pt</Width></BottomBorder>
                        <PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><PaddingRight>3pt</PaddingRight>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="CellUmbral">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=CStr(Fields!Threshold.Value)</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                      <Style>
                        <BottomBorder><Style>Solid</Style><Color>#EAEAEA</Color><Width>0.5pt</Width></BottomBorder>
                        <PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><PaddingRight>3pt</PaddingRight>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="CellFaltante">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=CStr(Fields!DeficitQuantity.Value)</Value><Style><FontFamily>Arial</FontFamily><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                      <Style>
                        <BottomBorder><Style>Solid</Style><Color>#EAEAEA</Color><Width>0.5pt</Width></BottomBorder>
                        <PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom><PaddingRight>3pt</PaddingRight>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="CellEstado">
                      <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!AlertLevel.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>=IIf(Fields!AlertLevel.Value = "AGOTADO", "#C0392B", "#D35400")</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                      <Style>
                        <BottomBorder><Style>Solid</Style><Color>#EAEAEA</Color><Width>0.5pt</Width></BottomBorder>
                        <PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>
          </TablixRows>
        </TablixBody>
        <TablixColumnHierarchy>
          <TablixMembers><TablixMember/><TablixMember/><TablixMember/><TablixMember/><TablixMember/><TablixMember/><TablixMember/><TablixMember/></TablixMembers>
