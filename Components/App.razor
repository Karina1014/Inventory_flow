<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>
        (function () {
            var theme = localStorage.getItem('medvet_theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();

        window.medvetTheme = {
            getTheme: function () {
                return localStorage.getItem('medvet_theme') || 'light';
            },
            setTheme: function (theme) {
                localStorage.setItem('medvet_theme', theme);
                document.documentElement.setAttribute('data-theme', theme);
                document.documentElement.setAttribute('data-bs-theme', theme);
                return theme;
            },
            toggleTheme: function () {
                var current = localStorage.getItem('medvet_theme') || 'light';
                var next = current === 'dark' ? 'light' : 'dark';
                return window.medvetTheme.setTheme(next);
            }
        };
    </script>
    <link rel="icon" type="image/jpeg" href="img/logo-medvet.jpg" />
    <link rel="stylesheet" href="lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="css/app.css?v=@AssetsVersion" />
    <link rel="stylesheet" href="Inventory_Flow.styles.css?v=@AssetsVersion" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    // Cambia en cada compilación: evita que el navegador use un bundle de CSS viejo
    private static readonly string AssetsVersion =
        typeof(App).Assembly.ManifestModule.ModuleVersionId.ToString("N")[..8];
}

