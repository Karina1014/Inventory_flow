@page "/warehouses"
@layout MainLayout
@using Inventory_Flow.Models
@using Inventory_Flow.Models.Dtos
@using Inventory_Flow.Repository.IRepository
@inject IWarehouseRepository WarehouseRepo
@inject Inventory_Flow.Services.IToastNotificationService ToastService

<div class="page-container">
    <!-- ENCABEZADO CON ÍCONO EN CAJA REDONDEADA -->
    <div class="page-header-block">
        <div class="header-icon-box">
            <i class="bi bi-building"></i>
        </div>
        <div>
            <h1 class="title">Sucursales</h1>
            <p class="subtitle">Gestión de sucursales y puntos de almacenamiento de inventario.</p>
        </div>
    </div>

    <!-- BARRA DE BÚSQUEDA Y SELECTOR DE ESTADO A LA IZQUIERDA + BOTÓN AÑADIR A LA DERECHA -->
    <div class="table-toolbar">
        <div class="toolbar-left">
            <div class="filter-search-box">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Buscar nombre o dirección..." @bind="searchTerm" @bind:event="oninput" @bind:after="OnFilterChangedAsync" />
            </div>

            <div class="custom-select-container filter-select-width">
                <button type="button"
                        class="custom-select-trigger @(isStatusFilterOpen ? "open" : "")"
                        @onclick="ToggleStatusFilterDropdown">
                    <div class="trigger-content">
                        <i class="bi bi-sliders trigger-icon"></i>
                        <span class="trigger-text">@GetStatusFilterName()</span>
                    </div>
                    <i class="bi bi-chevron-down trigger-chevron"></i>
                </button>

                @if (isStatusFilterOpen)
                {
                    <div class="dropdown-backdrop" @onclick="CloseAllDropdowns"></div>
                    <div class="custom-select-menu">
                        <button type="button"
                                class="custom-select-option @(statusFilter == "all" ? "active" : "")"
                                @onclick='() => SelectStatusFilterAsync("all")'>
                            <span>Todos los estados</span>
                            @if (statusFilter == "all")
                            {
                                <i class="bi bi-check2 option-check"></i>
                            }
                        </button>
                        <button type="button"
                                class="custom-select-option @(statusFilter == "active" ? "active" : "")"
                                @onclick='() => SelectStatusFilterAsync("active")'>
                            <span>Activos</span>
                            @if (statusFilter == "active")
                            {
                                <i class="bi bi-check2 option-check"></i>
                            }
                        </button>
                        <button type="button"
                                class="custom-select-option @(statusFilter == "inactive" ? "active" : "")"
                                @onclick='() => SelectStatusFilterAsync("inactive")'>
                            <span>Inactivos</span>
                            @if (statusFilter == "inactive")
                            {
                                <i class="bi bi-check2 option-check"></i>
                            }
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="toolbar-right">
            <button type="button" class="btn-primary" @onclick="OpenCreate">
                <i class="bi bi-plus-lg"></i>
                <span>Nueva sucursal</span>
            </button>
        </div>
    </div>

    <!-- TABLA PRINCIPAL ESTILO CUADRÍCULA LIMPIA (SIN COLUMNA ID) -->
    <div class="panel">
        @if (warehouses.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-building"></i>
                <span>No se encontraron sucursales registradas</span>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Dirección</th>
                            <th>Estado</th>
                            <th>Creado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var w in warehouses)
                        {
                            <tr>
                                <td class="col-name">@w.Name</td>
                                <td class="col-address">@w.Address</td>
                                <td>
                                    @if (w.IsActive)
                                    {
                                        <span class="badge badge-active">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-inactive">Inactivo</span>
                                    }
                                </td>
                                <td class="col-date">@w.CreationDate.ToString("dd/MM/yyyy")</td>
                                <td class="col-actions">
                                    <button type="button" class="action-btn btn-edit" @onclick="() => OpenEdit(w)" title="Editar">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                    <button type="button" class="action-btn btn-delete" @onclick="() => OpenDelete(w)" title="Eliminar">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <TablePagination TotalItems="@totalWarehousesCount"
                             @bind-CurrentPage="currentPage"
                             @bind-PageSize="pageSize"
                             OnPageChanged="LoadWarehousesAsync" />
        }
    </div>
</div>

@if (showModal)
{
    <div class="modal-backdrop" @onclick="CloseModal"></div>
    <div class="modal-box">
        <div class="modal-header">
            <span class="modal-title">@(isEditing ? "Editar sucursal" : "Nueva sucursal")</span>
            <button type="button" class="modal-close" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label class="form-label">Nombre <span class="required">*</span></label>
                <div class="input-box">
                    <i class="bi bi-building input-icon"></i>
                    <input class="form-input" type="text" placeholder="Nombre de la sucursal"
                           @bind="formName" @bind:event="oninput" />
                </div>
                @if (showValidation && string.IsNullOrWhiteSpace(formName))
                {
                    <span class="field-error">El nombre es requerido.</span>
                }
            </div>

            <div class="form-group">
                <label class="form-label">Dirección <span class="required">*</span></label>
                <div class="input-box">
                    <i class="bi bi-geo-alt input-icon"></i>
                    <input class="form-input" type="text" placeholder="Dirección de la sucursal"
                           @bind="formAddress" @bind:event="oninput" />
                </div>
                @if (showValidation && string.IsNullOrWhiteSpace(formAddress))
                {
                    <span class="field-error">La dirección es requerida.</span>
                }
            </div>

            <div class="form-group toggle-group">
                <label class="form-label">Estado</label>
                <label class="toggle-switch">
                    <input type="checkbox" @bind="formIsActive" />
                    <span class="toggle-slider"></span>
                    <span class="toggle-label">@(formIsActive ? "Activo" : "Inactivo")</span>
                </label>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert-error">@errorMessage</div>
            }
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-cancel" @onclick="CloseModal">Cancelar</button>
            <button type="button" class="btn-save" @onclick="Save" disabled="@isSaving">
                @if (isSaving)
                {
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Guardar</span>
                }
            </button>
        </div>
    </div>
}

@if (showDeleteModal)
{
    <div class="modal-backdrop" @onclick="CloseModal"></div>
    <div class="modal-box modal-sm">
        <div class="modal-header">
            <span class="modal-title">Confirmar eliminación</span>
            <button type="button" class="modal-close" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="modal-body">
            <p class="delete-msg">¿Deseas eliminar la sucursal <strong>@selectedWarehouse?.Name</strong>? Esta acción no se puede deshacer.</p>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-cancel" @onclick="CloseModal">Cancelar</button>
            <button type="button" class="btn-danger" @onclick="ConfirmDelete" disabled="@isSaving">
                @if (isSaving) { <span>Eliminando...</span> } else { <span>Eliminar</span> }
            </button>
        </div>
    </div>
}

@code {
    private List<Warehouse> warehouses = new();
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalWarehousesCount;

    private string searchTerm = string.Empty;
    private string statusFilter = "all";
    private bool isStatusFilterOpen;

    private bool showModal;
    private bool showDeleteModal;
    private bool isEditing;
    private bool isSaving;
    private bool showValidation;

    private string formName = string.Empty;
    private string formAddress = string.Empty;
    private bool formIsActive = true;
    private string errorMessage = string.Empty;

    private Warehouse? selectedWarehouse;

    protected override async Task OnInitializedAsync()
    {
        await LoadWarehousesAsync();
    }

    private async Task LoadWarehousesAsync()
    {
        var paged = await WarehouseRepo.GetWarehousesPagedAsync(currentPage, pageSize, searchTerm, statusFilter);
        warehouses = paged.Items.ToList();
        totalWarehousesCount = paged.TotalCount;
        currentPage = paged.PageNumber;
    }

    private async Task OnFilterChangedAsync()
    {
        currentPage = 1;
        await LoadWarehousesAsync();
    }

    private void CloseAllDropdowns()
    {
        isStatusFilterOpen = false;
    }

    private void ToggleStatusFilterDropdown()
    {
        isStatusFilterOpen = !isStatusFilterOpen;
    }

    private async Task SelectStatusFilterAsync(string status)
    {
        statusFilter = status;
        isStatusFilterOpen = false;
        currentPage = 1;
        await LoadWarehousesAsync();
    }

    private string GetStatusFilterName() => statusFilter switch
    {
        "active"   => "Activos",
        "inactive" => "Inactivos",
        _          => "Todos los estados"
    };

    private void OpenCreate()
    {
        formName = string.Empty;
        formAddress = string.Empty;
        formIsActive = true;
        errorMessage = string.Empty;
        showValidation = false;
        isEditing = false;
        selectedWarehouse = null;
        showModal = true;
    }

    private void OpenEdit(Warehouse w)
    {
        selectedWarehouse = w;
        formName = w.Name;
        formAddress = w.Address;
        formIsActive = w.IsActive;
        errorMessage = string.Empty;
        showValidation = false;
        isEditing = true;
        showModal = true;
    }

    private void OpenDelete(Warehouse w)
    {
        selectedWarehouse = w;
        showDeleteModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        showDeleteModal = false;
        isSaving = false;
        errorMessage = string.Empty;
    }

    private async Task Save()
    {
        showValidation = true;

        if (string.IsNullOrWhiteSpace(formName) || string.IsNullOrWhiteSpace(formAddress))
            return;

        isSaving = true;
        errorMessage = string.Empty;

        try
        {
            if (isEditing && selectedWarehouse != null)
            {
                var dto = new UpdateWarehouseDto
                {
                    Name = formName.Trim(),
                    Address = formAddress.Trim(),
                    IsActive = formIsActive
                };
                await WarehouseRepo.UpdateWarehouse(selectedWarehouse.IdWarehouse, dto);
                ToastService.ShowSuccess("Sucursal actualizada correctamente.");
            }
            else
            {
                var dto = new CreateWarehouseDto
                {
                    Name = formName.Trim(),
                    Address = formAddress.Trim(),
                    IsActive = formIsActive
                };
                await WarehouseRepo.CreateWarehouse(dto);
                ToastService.ShowSuccess("Sucursal creada correctamente.");
            }

            await LoadWarehousesAsync();
            CloseModal();
        }
        catch
        {
            errorMessage = "Ocurrió un error al guardar. Intenta nuevamente.";
            isSaving = false;
        }
    }

    private async Task ConfirmDelete()
    {
        if (selectedWarehouse == null) return;

        isSaving = true;
        try
        {
            WarehouseRepo.DeleteWarehouse(selectedWarehouse.IdWarehouse);
            ToastService.ShowSuccess("Sucursal eliminada correctamente.");
            await LoadWarehousesAsync();
            CloseModal();
        }
        catch
        {
            errorMessage = "No se pudo eliminar la sucursal.";
            isSaving = false;
        }
    }
}
