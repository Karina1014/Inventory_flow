@page "/analytics"
@layout MainLayout
@using Inventory_Flow.Models
@using Inventory_Flow.Models.Dtos.Ai
@using Inventory_Flow.Repository.IRepository
@using Inventory_Flow.Services
@inject IFinancialAiAssistantService AiAssistantService
@inject IWarehouseRepository WarehouseRepo
@inject NavigationManager NavigationManager
@inject IToastNotificationService ToastService

<div class="page-container">
    <div class="page-header">
        <div>
            <h1 class="title">Analítica Inteligente con IA</h1>
            <p class="subtitle">Asistente cognitivo con Google Gemini para auditoría de compras y métricas del inventario</p>
        </div>
        <div class="d-flex gap-2">
            @if (activeTab == TabFinancial)
            {
                <button class="btn-secondary" @onclick="LoadPendingOrdersAsync">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>Actualizar Órdenes</span>
                </button>
            }
            else
            {
                <button class="btn-secondary" @onclick="ResetInventoryForm">
                    <i class="bi bi-arrow-clockwise"></i>
                    <span>Restablecer Filtros</span>
                </button>
            }
        </div>
    </div>

    <!-- Pestañas de Navegación Principal -->
    <div class="ai-tabs-container mb-3">
        <button type="button"
                class="ai-tab-btn @(activeTab == TabFinancial ? "active" : "")"
                @onclick="() => SwitchTab(TabFinancial)">
            <i class="bi bi-cash-coin me-1"></i>
            <span>Asistente para la Aprobación Financiera</span>
            @if (pendingOrders.Count > 0)
            {
                <span class="ai-tab-badge">@pendingOrders.Count pendientes</span>
            }
        </button>
        <button type="button"
                class="ai-tab-btn @(activeTab == TabInventory ? "active" : "")"
                @onclick="() => SwitchTab(TabInventory)">
            <i class="bi bi-graph-up-arrow me-1"></i>
            <span>Analítica Global de Inventario & KPIs</span>
        </button>
    </div>

    <!-- ==================== PESTAÑA 1: ASISTENTE PARA LA APROBACIÓN FINANCIERA ==================== -->
    @if (activeTab == TabFinancial)
    {
        <div class="panel form-panel mb-3">
            <div class="panel-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="sparkle-icon"><i class="bi bi-stars"></i></span>
                    <span class="panel-title">Auditoría Financiera de Órdenes de Compra (Gemini Live)</span>
                </div>
                <span class="record-count">Detección de sobreprecios, cambios de proveedor y cantidades inusuales</span>
            </div>

            <div class="form-body">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-8">
                        <label class="form-label">Seleccionar Orden de Compra Pendiente de Aprobación</label>
                        @if (isLoadingOrders)
                        {
                            <div class="form-input text-muted">Cargando órdenes pendientes...</div>
                        }
                        else if (pendingOrders.Count == 0)
                        {
                            <div class="alert alert-info py-2 px-3 mb-0 small d-flex align-items-center justify-content-between">
                                <span><i class="bi bi-info-circle me-1"></i>No hay órdenes pendientes en este momento. Puedes crear una nueva en Órdenes de Compra.</span>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick='() => NavigationManager.NavigateTo("purchase-orders")'>
                                    Crear Orden
                                </button>
                            </div>
                        }
                        else
                        {
                            <select class="form-input" @bind="selectedOrderId">
                                @foreach (var o in pendingOrders)
                                {
                                    <option value="@o.IdPurchaseOrder">
                                        @o.OrderNumber · @(o.Supplier?.CompanyName ?? "Proveedor") · Total: $@o.TotalAmount.ToString("N2") · (@(o.PurchaseOrderType?.Name ?? "Estándar"))
                                    </option>
                                }
                            </select>
                        }
                    </div>

                    <div class="col-12 col-md-4">
                        <button class="btn-primary w-100 justify-content-center"
                                @onclick="AnalyzeOrderAsync"
                                disabled="@(isAnalyzing || (pendingOrders.Count == 0 && selectedOrderId <= 0))">
                            @if (isAnalyzing)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                <span>Auditando con Gemini...</span>
                            }
                            else
                            {
                                <i class="bi bi-stars me-1"></i>
                                <span>Analizar con Asistente IA</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if (isAnalyzing)
        {
            <div class="panel p-4 text-center">
                <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
                <h5 class="fw-bold text-dark">Analizando con Google Gemini en Vivo...</h5>
                <p class="text-muted small mb-0">Consultando histórico de compras en SQL Server, evaluando variaciones de precios y proyectando meses de cobertura.</p>
            </div>
        }
        else if (analysisResult != null)
        {
            <!-- Veredicto Principal de la IA -->
            <div class="panel mb-3 overflow-hidden border-top-0">
                <div class="ai-verdict-banner @GetVerdictBannerClass(analysisResult.RiskLevel)">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="verdict-icon-box">
                                <i class="bi @GetVerdictIcon(analysisResult.RiskLevel)"></i>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2">
                                    <h4 class="mb-0 fw-bold">Veredicto IA: @analysisResult.Recommendation</h4>
                                    <span class="ai-badge-pill @analysisResult.RiskBadgeClass">Riesgo @analysisResult.RiskLevel</span>
                                </div>
                                <span class="verdict-subtext">
                                    Orden N° <strong>@analysisResult.OrderNumber</strong> · Proveedor: <strong>@analysisResult.SupplierName</strong> · @analysisResult.AiModelUsed
                                </span>
                            </div>
                        </div>

                        <div>
                            <button type="button" class="btn btn-sm btn-light fw-semibold" @onclick='() => NavigationManager.NavigateTo("purchase-orders")'>
                                <i class="bi bi-box-arrow-up-right me-1"></i>Gestionar en Órdenes de Compra
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Resumen Ejecutivo Narrativo de Gemini -->
                <div class="p-3 bg-light border-bottom">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-chat-quote-fill text-primary fs-5 mt-1"></i>
                        <div>
                            <span class="fw-bold text-dark d-block mb-1">Diagnóstico Ejecutivo del Asistente:</span>
                            <p class="mb-0 text-secondary" style="line-height: 1.55;">@analysisResult.ExecutiveSummary</p>
                        </div>
                    </div>
                </div>

                <!-- Métricas Clave de Auditoría -->
                <div class="p-3">
                    <div class="row g-2">
                        <div class="col-6 col-md-3">
                            <div class="kpi-micro-card">
                                <span class="micro-label">Monto de la Orden</span>
                                <span class="micro-value text-dark">$@analysisResult.TotalAmount.ToString("N2")</span>
                                <span class="micro-hint">@analysisResult.TotalItemsCount productos</span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="kpi-micro-card">
                                <span class="micro-label">Variación Media de Precio</span>
                                <span class="micro-value @(analysisResult.AveragePriceVariancePct > 5 ? "text-danger" : "text-success")">
                                    @(analysisResult.AveragePriceVariancePct > 0 ? "+" : "")@analysisResult.AveragePriceVariancePct.ToString("0.#")%
                                </span>
                                <span class="micro-hint">vs. compras previas</span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="kpi-micro-card">
                                <span class="micro-label">Sobrecosto Potencial</span>
                                <span class="micro-value @(analysisResult.PotentialOvercostAmount > 0 ? "text-danger" : "text-success")">
                                    $@analysisResult.PotentialOvercostAmount.ToString("N2")
                                </span>
                                <span class="micro-hint">impacto estimado</span>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="kpi-micro-card">
                                <span class="micro-label">Alertas Detectadas</span>
                                <span class="micro-value @(analysisResult.AnomalousPriceCount + analysisResult.AnomalousQuantityCount > 0 ? "text-warning" : "text-success")">
                                    @(analysisResult.AnomalousPriceCount + analysisResult.AnomalousQuantityCount)
                                </span>
                                <span class="micro-hint">@analysisResult.AnomalousPriceCount precios · @analysisResult.AnomalousQuantityCount cantidades</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tabla Detallada por Producto -->
            <div class="panel">
                <div class="panel-header">
                    <span class="panel-title">Auditoría Detallada Ítem por Ítem (@analysisResult.ItemsAnalysis.Count)</span>
                    <span class="record-count">Comparativa de precios unitarios y meses de inventario proyectados</span>
                </div>

                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Producto / SKU</th>
                                <th>Pedido vs. Stock</th>
                                <th>Meses Cobertura</th>
                                <th>Precio Pactado</th>
                                <th>Último Precio</th>
                                <th>Variación %</th>
                                <th>Diagnóstico Gemini</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var it in analysisResult.ItemsAnalysis)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold text-dark">@it.ProductName</div>
                                        <div class="text-muted small">SKU: @it.ProductCode · @it.CategoryName</div>
                                    </td>
                                    <td>
                                        <div><strong>@it.RequestedQuantity u.</strong> pedidas</div>
                                        <div class="text-muted small">Stock actual: @it.CurrentPhysicalStock u.</div>
                                    </td>
                                    <td>
                                        <span class="badge @(it.MonthsOfCoverage > 3.5m ? "bg-warning text-dark" : "bg-light text-secondary border")">
                                            @it.MonthsOfCoverage.ToString("0.#") meses
                                        </span>
                                        <div class="text-muted small" style="font-size:0.75rem;">Consumo: @it.MonthlyConsumptionAvg u./mes</div>
                                    </td>
                                    <td class="fw-semibold text-dark">$@it.CurrentUnitPrice.ToString("N2")</td>
                                    <td>
                                        @if (it.LastPurchasedPrice.HasValue)
                                        {
                                            <span>$@it.LastPurchasedPrice.Value.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Primera compra</span>
                                        }
                                    </td>
                                    <td>
                                        @if (it.PriceVariancePct > 10)
                                        {
                                            <span class="badge bg-danger">+@it.PriceVariancePct.ToString("0.#")%</span>
                                        }
                                        else if (it.PriceVariancePct > 0)
                                        {
                                            <span class="badge bg-warning text-dark">+@it.PriceVariancePct.ToString("0.#")%</span>
                                        }
                                        else if (it.PriceVariancePct < 0)
                                        {
                                            <span class="badge bg-success">@it.PriceVariancePct.ToString("0.#")%</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary border">0.0%</span>
                                        }
                                    </td>
                                    <td style="max-width: 280px;">
                                        <div class="small text-dark mb-1">@it.PriceInsight</div>
                                        <div class="small text-muted" style="font-size: 0.76rem;">@it.QuantityInsight</div>
                                    </td>
                                    <td>
                                        <span class="sev-badge @(it.ItemStatus == "Crítico" || it.ItemStatus == "Sobreprecio" ? "sev-alta" : (it.ItemStatus == "Sobrecompra" ? "sev-media" : "sev-baja"))">
                                            @it.ItemStatus
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <div class="panel empty-result">
                <i class="bi bi-cash-coin text-primary"></i>
                <span class="empty-result-title">Auditoría Financiera Lista</span>
                <span class="empty-result-text">
                    Selecciona una orden de compra pendiente de aprobación y haz clic en <strong>Analizar con Asistente IA</strong> para auditar precios y cantidades en vivo con Gemini.
                </span>
            </div>
        }
    }

    <!-- ==================== PESTAÑA 2: ANALÍTICA GLOBAL DE INVENTARIO ==================== -->
    @if (activeTab == TabInventory)
    {
        <div class="panel form-panel mb-3">
            <div class="panel-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="sparkle-icon"><i class="bi bi-stars"></i></span>
                    <span class="panel-title">Diagnóstico Integral del Inventario con Google Gemini</span>
                </div>
                <span class="record-count">Métricas extraídas 100% en vivo desde SQL Server</span>
            </div>

            <div class="form-body">
                <div class="form-grid grid-3">
                    <div class="form-group">
                        <label class="form-label">Fecha Inicio</label>
                        <input type="date" class="form-input" @bind="inventoryStartDate" @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Fecha Fin</label>
                        <input type="date" class="form-input" @bind="inventoryEndDate" @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Almacén / Sucursal</label>
                        <select class="form-input" @bind="selectedWarehouseId">
                            <option value="0">Todas las sucursales (Consolidado)</option>
                            @foreach (var w in availableWarehouses)
                            {
                                <option value="@w.IdWarehouse">@w.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="form-actions">
                    <button class="btn-primary" @onclick="AnalyzeGlobalInventoryAsync" disabled="@isAnalyzingGlobal">
                        @if (isAnalyzingGlobal)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Analizando en vivo con Gemini...</span>
                        }
                        else
                        {
                            <i class="bi bi-stars me-1"></i>
                            <span>Ejecutar Diagnóstico IA del Inventario</span>
                        }
                    </button>
                    <span class="form-hint">
                        Período de @TotalInventoryDays días · @(selectedWarehouseId == 0 ? "Consolidado" : availableWarehouses.FirstOrDefault(w => w.IdWarehouse == selectedWarehouseId)?.Name ?? "Sucursal")
                    </span>
                </div>
            </div>
        </div>

        @if (isAnalyzingGlobal)
        {
            <div class="panel p-4 text-center">
                <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
                <h5 class="fw-bold text-dark">Calculando KPIs y Generando Diagnóstico con Gemini...</h5>
                <p class="text-muted small mb-0">Extrayendo existencias, caducidades y valor total desde SQL Server.</p>
            </div>
        }
        else if (globalAiResult != null)
        {
            <!-- KPIs Reales de SQL Server -->
            <div class="real-kpis mb-3">
                <div class="real-kpi-card">
                    <span class="real-kpi-label">Valor del Inventario</span>
                    <span class="real-kpi-value text-primary">$@globalAiResult.TotalInventoryValue.ToString("N2")</span>
                    <span class="real-kpi-hint">@globalAiResult.TotalUnitsCount.ToString("N0") unidades en stock</span>
                </div>
                <div class="real-kpi-card">
                    <span class="real-kpi-label">Productos Bajo Stock</span>
                    <span class="real-kpi-value @(globalAiResult.LowStockProductsCount > 0 ? "text-warning" : "text-success")">@globalAiResult.LowStockProductsCount</span>
                    <span class="real-kpi-hint">requieren reposición</span>
                </div>
                <div class="real-kpi-card">
                    <span class="real-kpi-label">Lotes Vencidos / Próximos</span>
                    <span class="real-kpi-value @(globalAiResult.ExpiredLotsCount > 0 ? "text-danger" : "text-secondary")">@globalAiResult.ExpiredLotsCount / @globalAiResult.ExpiringSoonLotsCount</span>
                    <span class="real-kpi-hint">ventana de 30 días</span>
                </div>
                <div class="real-kpi-card">
                    <span class="real-kpi-label">Movimientos Realizados</span>
                    <span class="real-kpi-value text-dark">@globalAiResult.TotalMovementsCount</span>
                    <span class="real-kpi-hint">en el período evaluado</span>
                </div>
            </div>

            <!-- Resumen Ejecutivo Gemini -->
            <div class="panel summary-panel mb-3">
                <div class="panel-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-chat-quote-fill text-primary"></i>
                        <span class="panel-title">Resumen Ejecutivo del Inventario</span>
                    </div>
                    <span class="record-count">@globalAiResult.AiModelUsed · @globalAiResult.AnalyzedAt.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="summary-body">
                    <p class="summary-text mb-0">@globalAiResult.ExecutiveSummary</p>
                </div>
            </div>

            <!-- Hallazgos y Recomendaciones en 2 Columnas -->
            <div class="analytics-columns">
                <div class="panel">
                    <div class="panel-header">
                        <span class="panel-title">Hallazgos Operativos IA (@globalAiResult.Findings.Count)</span>
                    </div>
                    <div class="findings-list">
                        @if (globalAiResult.Findings.Count == 0)
                        {
                            <div class="p-3 text-muted small">No se detectaron anomalías críticas en el inventario.</div>
                        }
                        else
                        {
                            @foreach (var finding in globalAiResult.Findings)
                            {
                                <div class="finding-item">
                                    <span class="sev-badge @finding.SeverityClass">@finding.Severity</span>
                                    <div class="finding-body">
                                        <span class="finding-type">@finding.Type</span>
                                        <p class="finding-message">@finding.Message</p>
                                        <span class="finding-evidence">@finding.Evidence</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="panel">
                    <div class="panel-header">
                        <span class="panel-title">Recomendaciones Estratégicas (@globalAiResult.Recommendations.Count)</span>
                    </div>
                    <div class="table-wrapper">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Acción Recomendada</th>
                                    <th>Objetivo</th>
                                    <th>Cantidad</th>
                                    <th>Prioridad</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (globalAiResult.Recommendations.Count == 0)
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-3">Inventario en balance óptimo.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var rec in globalAiResult.Recommendations)
                                    {
                                        <tr>
                                            <td>@rec.Action</td>
                                            <td class="col-name">@rec.Target</td>
                                            <td>@rec.QuantityLabel</td>
                                            <td><span class="sev-badge @rec.PriorityClass">@rec.Priority</span></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="panel empty-result">
                <i class="bi bi-graph-up-arrow text-primary"></i>
                <span class="empty-result-title">Diagnóstico General del Inventario</span>
                <span class="empty-result-text">
                    Haz clic en <strong>Ejecutar Diagnóstico IA del Inventario</strong> para extraer las existencias en vivo de SQL Server y analizarlas con Gemini.
                </span>
            </div>
        }
    }
</div>

@code {
    private const string TabFinancial = "financial";
    private const string TabInventory = "inventory";
    private string activeTab = TabFinancial;

    // Pestaña 1: Asistente Financiero
    private List<PurchaseOrder> pendingOrders = new();
    private int selectedOrderId = 0;
    private bool isLoadingOrders = false;
    private bool isAnalyzing = false;
    private FinancialOrderAnalysisDto? analysisResult;

    // Pestaña 2: Analítica Global
    private List<Warehouse> availableWarehouses = new();
    private int selectedWarehouseId = 0;
    private DateTime inventoryStartDate = DateTime.Today.AddDays(-30);
    private DateTime inventoryEndDate = DateTime.Today;
    private bool isAnalyzingGlobal = false;
    private GlobalInventoryAiAnalysisDto? globalAiResult;

    private int TotalInventoryDays => Math.Max((inventoryEndDate.Date - inventoryStartDate.Date).Days, 1);

    protected override async Task OnInitializedAsync()
    {
        await LoadPendingOrdersAsync();
        availableWarehouses = WarehouseRepo.GetWarehouses().Where(w => w.IsActive).OrderBy(w => w.Name).ToList();
    }

    private void SwitchTab(string tab)
    {
        activeTab = tab;
    }

    private async Task LoadPendingOrdersAsync()
    {
        isLoadingOrders = true;
        try
        {
            pendingOrders = await AiAssistantService.GetPendingOrdersForAnalysisAsync();
            if (pendingOrders.Count > 0)
            {
                selectedOrderId = pendingOrders[0].IdPurchaseOrder;
            }
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error al consultar órdenes pendientes: {ex.Message}", "Asistente IA");
        }
        finally
        {
            isLoadingOrders = false;
        }
    }

    private async Task AnalyzeOrderAsync()
    {
        if (selectedOrderId <= 0)
        {
            ToastService.Warning("Selecciona una orden de compra para analizar.", "Atención");
            return;
        }

        isAnalyzing = true;
        analysisResult = null;
        try
        {
            analysisResult = await AiAssistantService.AnalyzePurchaseOrderAsync(selectedOrderId);
            ToastService.Success($"Análisis generado en vivo con {analysisResult.AiModelUsed}.", "Gemini IA");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error en el análisis de Gemini: {ex.Message}", "Error IA");
        }
        finally
        {
            isAnalyzing = false;
        }
    }

    private async Task AnalyzeGlobalInventoryAsync()
    {
        isAnalyzingGlobal = true;
        globalAiResult = null;
        try
        {
            globalAiResult = await AiAssistantService.AnalyzeGlobalInventoryAsync(
                selectedWarehouseId > 0 ? selectedWarehouseId : null,
                inventoryStartDate,
                inventoryEndDate);

            ToastService.Success($"Diagnóstico completado en vivo con {globalAiResult.AiModelUsed}.", "Gemini IA");
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error al analizar inventario con Gemini: {ex.Message}", "Error IA");
        }
        finally
        {
            isAnalyzingGlobal = false;
        }
    }

    private void ResetInventoryForm()
    {
        inventoryStartDate = DateTime.Today.AddDays(-30);
        inventoryEndDate = DateTime.Today;
        selectedWarehouseId = 0;
        globalAiResult = null;
    }

    private string GetVerdictBannerClass(string riskLevel) => riskLevel switch
    {
        "Alto" => "banner-risk-high",
        "Moderado" => "banner-risk-med",
        _ => "banner-risk-low"
    };

    private string GetVerdictIcon(string riskLevel) => riskLevel switch
    {
        "Alto" => "bi-exclamation-octagon-fill",
        "Moderado" => "bi-exclamation-triangle-fill",
        _ => "bi-check-circle-fill"
    };
}
