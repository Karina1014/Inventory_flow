@page "/movementtypes"
@layout MainLayout
@using Inventory_Flow.Models
@using Inventory_Flow.Models.Dtos
@using Inventory_Flow.Repository.IRepository
@inject IMovementTypeRepository MovementRepo
@inject Inventory_Flow.Services.IToastNotificationService ToastService

<div class="page-container">
    <!-- ENCABEZADO CON ÍCONO EN CAJA REDONDEADA -->
    <div class="page-header-block">
        <div class="header-icon-box">
            <i class="bi bi-arrow-left-right"></i>
        </div>
        <div>
            <h1 class="title">Tipos de movimientos</h1>
            <p class="subtitle">Configuración y clasificación de los movimientos de inventario.</p>
        </div>
    </div>

    <!-- BARRA DE HERRAMIENTAS: BÚSQUEDA Y FILTROS A LA IZQUIERDA + BOTÓN NUEVO A LA DERECHA -->
    <div class="table-toolbar">
        <div class="toolbar-left">
            <!-- BUSCADOR -->
            <div class="filter-search-box">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Buscar código, modo o descripción..."
                       @bind="searchTerm" @bind:event="oninput" @bind:after="OnFilterChangedAsync" />
            </div>

            <!-- SELECTOR DESPLEGABLE DE MODO -->
            <div class="custom-select-container filter-mode-width">
                <button type="button"
                        class="custom-select-trigger @(isModeFilterOpen ? "open" : "")"
                        @onclick="ToggleModeFilterDropdown">
                    <div class="trigger-content">
                        <i class="bi bi-shuffle trigger-icon"></i>
                        <span class="trigger-text">@GetModeFilterName()</span>
                    </div>
                    <i class="bi bi-chevron-down trigger-chevron"></i>
                </button>

                @if (isModeFilterOpen)
                {
                    <div class="dropdown-backdrop" @onclick="CloseAllDropdowns"></div>
                    <div class="custom-select-menu">
                        <button type="button"
                                class="custom-select-option @(selectedModeFilter == "all" ? "active" : "")"
                                @onclick='() => SelectModeFilterAsync("all")'>
                            <span>Todos los modos</span>
                            @if (selectedModeFilter == "all")
                            {
                                <i class="bi bi-check2 option-check"></i>
                            }
                        </button>
                        @foreach (var mode in availableModes)
                        {
                            <button type="button"
                                    class="custom-select-option @(selectedModeFilter == mode ? "active" : "")"
                                    @onclick="() => SelectModeFilterAsync(mode)">
                                <span>@mode</span>
                                @if (selectedModeFilter == mode)
                                {
                                    <i class="bi bi-check2 option-check"></i>
                                }
                            </button>
                        }
                    </div>
                }
            </div>

            <!-- SELECTOR DESPLEGABLE DE FECHAS TIPO CALENDARIO -->
            <div class="custom-select-container filter-date-width">
                <button type="button"
                        class="custom-select-trigger @(isDateMenuOpen ? "open" : "")"
                        @onclick="ToggleDateMenu">
                    <div class="trigger-content">
                        <i class="bi bi-calendar3 trigger-icon"></i>
                        <span class="trigger-text">@GetDateFilterLabel()</span>
                    </div>
                    @if (selectedDatePreset != "all" || startDate.HasValue || endDate.HasValue)
                    {
                        <span class="clear-icon-wrapper" @onclick="ClearDateFilterAsync" @onclick:stopPropagation="true" title="Restablecer fechas">
                            <i class="bi bi-x-circle-fill clear-filter-icon"></i>
                        </span>
                    }
                    else
                    {
                        <i class="bi bi-chevron-down trigger-chevron"></i>
                    }
                </button>

                @if (isDateMenuOpen)
                {
                    <div class="dropdown-backdrop" @onclick="CloseAllDropdowns"></div>
                    <div class="date-menu-popover">
                        <div class="date-presets-list">
                            <button type="button"
                                    class="date-preset-btn @(selectedDatePreset == "all" ? "active" : "")"
                                    @onclick='() => SelectDatePresetAsync("all")'>
                                <i class="bi bi-infinity"></i>
                                <span>Todas las fechas</span>
                                @if (selectedDatePreset == "all") { <i class="bi bi-check2 option-check"></i> }
                            </button>
                            <button type="button"
                                    class="date-preset-btn @(selectedDatePreset == "today" ? "active" : "")"
                                    @onclick='() => SelectDatePresetAsync("today")'>
                                <i class="bi bi-calendar-day"></i>
                                <span>Hoy</span>
                                @if (selectedDatePreset == "today") { <i class="bi bi-check2 option-check"></i> }
                            </button>
                            <button type="button"
                                    class="date-preset-btn @(selectedDatePreset == "week" ? "active" : "")"
                                    @onclick='() => SelectDatePresetAsync("week")'>
                                <i class="bi bi-calendar-week"></i>
                                <span>Últimos 7 días</span>
                                @if (selectedDatePreset == "week") { <i class="bi bi-check2 option-check"></i> }
                            </button>
                            <button type="button"
                                    class="date-preset-btn @(selectedDatePreset == "month" ? "active" : "")"
                                    @onclick='() => SelectDatePresetAsync("month")'>
                                <i class="bi bi-calendar-month"></i>
                                <span>Este mes</span>
                                @if (selectedDatePreset == "month") { <i class="bi bi-check2 option-check"></i> }
                            </button>
                        </div>

                        <div class="date-menu-divider"></div>

                        <!-- RANGO PERSONALIZADO -->
                        <div class="custom-range-section">
                            <span class="custom-range-title">Rango de fechas específico</span>
                            <div class="custom-range-fields">
                                <div class="date-range-field">
                                    <label>Desde:</label>
                                    <input type="date" @bind="customStartDate" />
                                </div>
                                <div class="date-range-field">
                                    <label>Hasta:</label>
                                    <input type="date" @bind="customEndDate" />
                                </div>
                            </div>
                            <div class="custom-range-actions">
                                <button type="button" class="btn-apply-range" @onclick="ApplyCustomDateRangeAsync">
                                    Aplicar filtro
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="toolbar-right">
            <button type="button" class="btn-primary" @onclick="OpenCreate">
                <i class="bi bi-plus-lg"></i>
                <span>Nuevo tipo</span>
            </button>
        </div>
    </div>

    <!-- TABLA PRINCIPAL ESTILO CUADRÍCULA LIMPIA (SIN COLUMNA ID) -->
    <div class="panel">
        @if (movementTypes.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-arrow-left-right"></i>
                <span>No se encontraron tipos de movimientos registrados</span>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Modo</th>
                            <th>Descripción</th>
                            <th>Creado</th>
                            <th class="col-actions-header">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in movementTypes)
                        {
                            <tr>
                                <td class="col-code">
                                    <span class="code-pill">@m.Code</span>
                                </td>
                                <td>
                                    <span class="mode-badge @GetModeBadgeClass(m.Mode)">
                                        <i class="@GetModeIconClass(m.Mode)"></i>
                                        <span>@m.Mode</span>
                                    </span>
                                </td>
                                <td class="col-description" title="@m.Description">@m.Description</td>
                                <td class="col-date">@m.CreationDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="col-actions">
                                    <!-- BOTONES DE ACCIÓN DIRECTOS, CLAROS Y ATRACTIVOS (PILLS) -->
                                    <div class="actions-pill-group">
                                        <button type="button"
                                                class="btn-action-pill btn-pill-edit"
                                                @onclick="() => OpenEdit(m)"
                                                title="Editar @m.Code">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button type="button"
                                                class="btn-action-pill btn-pill-delete"
                                                @onclick="() => OpenDelete(m)"
                                                title="Eliminar @m.Code">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <TablePagination TotalItems="@totalMovementTypesCount"
                             @bind-CurrentPage="currentPage"
                             @bind-PageSize="pageSize"
                             OnPageChanged="LoadMovementTypesAsync" />
        }
    </div>
</div>

@if (showModal)
{
    <div class="modal-backdrop" @onclick="CloseModal"></div>
    <div class="modal-box">
        <div class="modal-header">
            <span class="modal-title">@(isEditing ? "Editar tipo de movimiento" : "Nuevo tipo de movimiento")</span>
            <button type="button" class="modal-close" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label class="form-label">Código <span class="required">*</span></label>
                <div class="input-box">
                    <i class="bi bi-upc-scan input-icon"></i>
                    <input class="form-input" type="text" placeholder="Ej: ENT-01"
                           @bind="formCode" @bind:event="oninput" />
                </div>
                @if (showValidation && string.IsNullOrWhiteSpace(formCode))
                {
                    <span class="field-error">El código es requerido.</span>
                }
            </div>

            <div class="form-group">
                <label class="form-label">Modo <span class="required">*</span></label>
                <div class="input-box">
                    <i class="bi bi-arrow-left-right input-icon"></i>
                    <select class="form-input" @bind="formMode">
                        <option value="">Seleccione el modo...</option>
                        @foreach (var mode in availableModes)
                        {
                            <option value="@mode">@mode</option>
                        }
                    </select>
                </div>
                @if (showValidation && string.IsNullOrWhiteSpace(formMode))
                {
                    <span class="field-error">El modo de movimiento es requerido.</span>
                }
            </div>

            <div class="form-group">
                <label class="form-label">Descripción</label>
                <div class="input-box textarea-box">
                    <i class="bi bi-card-text input-icon"></i>
                    <textarea class="form-input form-textarea" rows="2" placeholder="Detalles del tipo de movimiento..."
                              @bind="formDescription" @bind:event="oninput"></textarea>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert-error">@errorMessage</div>
            }
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-cancel" @onclick="CloseModal">Cancelar</button>
            <button type="button" class="btn-save" @onclick="Save" disabled="@isSaving">
                @if (isSaving)
                {
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Guardar</span>
                }
            </button>
        </div>
    </div>
}

@if (showDeleteModal)
{
    <div class="modal-backdrop" @onclick="CloseModal"></div>
    <div class="modal-box modal-sm">
        <div class="modal-header">
            <span class="modal-title">Confirmar eliminación</span>
            <button type="button" class="modal-close" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="modal-body">
            <p class="delete-msg">¿Deseas eliminar el tipo de movimiento <strong>@selectedMovementType?.Code</strong>? Esta acción no se puede deshacer.</p>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-cancel" @onclick="CloseModal">Cancelar</button>
            <button type="button" class="btn-danger" @onclick="ConfirmDelete" disabled="@isSaving">
                @if (isSaving) { <span>Eliminando...</span> } else { <span>Eliminar</span> }
            </button>
        </div>
    </div>
}

@code {
    private List<MovementType> movementTypes = new();
    private List<string> availableModes = new();
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalMovementTypesCount;

    private string searchTerm = string.Empty;
    private string selectedModeFilter = "all";
    private bool isModeFilterOpen;

    private string selectedDatePreset = "all";
    private DateTime? startDate;
    private DateTime? endDate;
    private DateTime? customStartDate;
    private DateTime? customEndDate;
    private bool isDateMenuOpen;

    private bool showModal;
    private bool showDeleteModal;
    private bool isEditing;
    private bool isSaving;
    private bool showValidation;

    private string formCode = string.Empty;
    private string formMode = string.Empty;
    private string formDescription = string.Empty;
    private string errorMessage = string.Empty;

    private MovementType? selectedMovementType;

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialDataAsync();
    }

    private async Task LoadInitialDataAsync()
    {
        try
        {
            var all = MovementRepo.GetMovementTypes();
            var distinctDbModes = all
                .Where(m => !string.IsNullOrWhiteSpace(m.Mode))
                .Select(m => m.Mode.Trim())
                .Distinct()
                .OrderBy(m => m)
                .ToList();

            // Modos consultados directamente desde la base de datos
            availableModes = distinctDbModes.Count > 0 
                ? distinctDbModes 
                : new List<string> { "Ingreso", "Egreso", "Traslado" };
        }
        catch
        {
            availableModes = new List<string> { "Ingreso", "Egreso", "Traslado" };
        }

        await LoadMovementTypesAsync();
    }

    private async Task LoadMovementTypesAsync()
    {
        try
        {
            var paged = await MovementRepo.GetMovementTypesPagedAsync(
                currentPage,
                pageSize,
                searchTerm,
                selectedModeFilter,
                startDate,
                endDate);

            movementTypes = paged.Items.ToList();
            totalMovementTypesCount = paged.TotalCount;
            currentPage = paged.PageNumber;
        }
        catch
        {
            errorMessage = "No se pudieron cargar los movimientos.";
        }
    }

    private async Task OnFilterChangedAsync()
    {
        currentPage = 1;
        await LoadMovementTypesAsync();
    }

    private void CloseAllDropdowns()
    {
        isModeFilterOpen = false;
        isDateMenuOpen = false;
    }

    private void ToggleModeFilterDropdown()
    {
        var current = isModeFilterOpen;
        CloseAllDropdowns();
        isModeFilterOpen = !current;
    }

    private async Task SelectModeFilterAsync(string mode)
    {
        selectedModeFilter = mode;
        isModeFilterOpen = false;
        currentPage = 1;
        await LoadMovementTypesAsync();
    }

    private string GetModeFilterName()
    {
        if (selectedModeFilter == "all") return "Todos los modos";
        return selectedModeFilter;
    }

    private void ToggleDateMenu()
    {
        var current = isDateMenuOpen;
        CloseAllDropdowns();
        isDateMenuOpen = !current;
    }

    private async Task SelectDatePresetAsync(string preset)
    {
        selectedDatePreset = preset;
        var now = DateTime.Today;

        switch (preset)
        {
            case "today":
                startDate = now;
                endDate = now;
                break;
            case "week":
                startDate = now.AddDays(-6);
                endDate = now;
                break;
            case "month":
                startDate = new DateTime(now.Year, now.Month, 1);
                endDate = now;
                break;
            case "all":
            default:
                selectedDatePreset = "all";
                startDate = null;
                endDate = null;
                break;
        }

        customStartDate = startDate;
        customEndDate = endDate;
        isDateMenuOpen = false;
        currentPage = 1;
        await LoadMovementTypesAsync();
    }

    private async Task ApplyCustomDateRangeAsync()
    {
        if (!customStartDate.HasValue && !customEndDate.HasValue)
        {
            await SelectDatePresetAsync("all");
            return;
        }

        startDate = customStartDate;
        endDate = customEndDate;
        selectedDatePreset = "custom";
        isDateMenuOpen = false;
        currentPage = 1;
        await LoadMovementTypesAsync();
    }

    private async Task ClearDateFilterAsync()
    {
        selectedDatePreset = "all";
        startDate = null;
        endDate = null;
        customStartDate = null;
        customEndDate = null;
        isDateMenuOpen = false;
        currentPage = 1;
        await LoadMovementTypesAsync();
    }

    private string GetDateFilterLabel()
    {
        return selectedDatePreset switch
        {
            "today" => "Hoy",
            "week" => "Últimos 7 días",
            "month" => "Este mes",
            "custom" when startDate.HasValue && endDate.HasValue => $"{startDate.Value:dd/MM} - {endDate.Value:dd/MM}",
            "custom" when startDate.HasValue => $"Desde {startDate.Value:dd/MM}",
            "custom" when endDate.HasValue => $"Hasta {endDate.Value:dd/MM}",
            _ => "Todas las fechas"
        };
    }

    private string GetModeBadgeClass(string? mode)
    {
        var m = mode?.Trim().ToLowerInvariant() ?? string.Empty;
        if (m == "ingreso" || m == "entrada" || m == "e") return "badge-entrada";
        if (m == "egreso" || m == "salida" || m == "s") return "badge-salida";
        if (m == "traslado" || m == "transferencia" || m == "t") return "badge-traslado";
        return "badge-default";
    }

    private string GetModeIconClass(string? mode)
    {
        var m = mode?.Trim().ToLowerInvariant() ?? string.Empty;
        if (m == "ingreso" || m == "entrada" || m == "e") return "bi bi-arrow-down-left";
        if (m == "egreso" || m == "salida" || m == "s") return "bi bi-arrow-up-right";
        if (m == "traslado" || m == "transferencia" || m == "t") return "bi bi-arrow-left-right";
        return "bi bi-arrow-left-right";
    }

    private void OpenCreate()
    {
        formCode = string.Empty;
        formMode = string.Empty;
        formDescription = string.Empty;
        errorMessage = string.Empty;
        showValidation = false;
        isEditing = false;
        selectedMovementType = null;
        showModal = true;
    }

    private void OpenEdit(MovementType m)
    {
        selectedMovementType = m;
        formCode = m.Code;
        formMode = m.Mode;
        formDescription = m.Description;
        errorMessage = string.Empty;
        showValidation = false;
        isEditing = true;
        showModal = true;
    }

    private void OpenDelete(MovementType m)
    {
        selectedMovementType = m;
        showDeleteModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        showDeleteModal = false;
        isSaving = false;
        errorMessage = string.Empty;
    }

    private async Task Save()
    {
        showValidation = true;

        if (string.IsNullOrWhiteSpace(formCode) || string.IsNullOrWhiteSpace(formMode))
            return;

        isSaving = true;
        errorMessage = string.Empty;

        try
        {
            if (isEditing && selectedMovementType != null)
            {
                var dto = new UpdateMovementTypeDto
                {
                    Code = formCode.Trim(),
                    Mode = formMode.Trim(),
                    Description = formDescription?.Trim() ?? string.Empty
                };
                await MovementRepo.UpdateMovementType(selectedMovementType.IdMovementType, dto);
                ToastService.ShowSuccess("Tipo de movimiento actualizado correctamente.");
            }
            else
            {
                var dto = new CreateMovementTypeDto
                {
                    Code = formCode.Trim(),
                    Mode = formMode.Trim(),
                    Description = formDescription?.Trim() ?? string.Empty
                };

                if (!MovementRepo.IsUniqueCode(dto.Code))
                {
                    errorMessage = "Ya existe un movimiento con ese código.";
                    isSaving = false;
                    return;
                }

                await MovementRepo.CreateMovementType(dto);
                ToastService.ShowSuccess("Tipo de movimiento creado correctamente.");
            }

            await LoadInitialDataAsync();
            CloseModal();
        }
        catch
        {
            errorMessage = "Ocurrió un error al guardar. Intenta nuevamente.";
            isSaving = false;
        }
    }

    private async Task ConfirmDelete()
    {
        if (selectedMovementType == null) return;

        isSaving = true;
        try
        {
            MovementRepo.DeleteMovementType(selectedMovementType.IdMovementType);
            ToastService.ShowSuccess("Tipo de movimiento eliminado correctamente.");
            await LoadInitialDataAsync();
            CloseModal();
        }
        catch
        {
            errorMessage = "No se pudo eliminar el movimiento.";
            isSaving = false;
        }
    }
}
