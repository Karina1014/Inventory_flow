@page "/users"
@layout MainLayout
@using Inventory_Flow.Models
@using Inventory_Flow.Models.Dtos
@using Inventory_Flow.Repository
@using Inventory_Flow.Repository.IRepository
@using RoleModel = Inventory_Flow.Models.Role
@inject IUserRepository UserRepo
@inject IRoleRepository RoleRepo

<div class="page-container">
    <div class="page-header">
        <div>
            <h1 class="title">Usuarios</h1>
            <p class="subtitle">Gestión de las cuentas de acceso al sistema</p>
        </div>
        <button class="btn-primary" @onclick="OpenCreate">
            <i class="bi bi-person-plus-fill"></i>
            Nuevo usuario
        </button>
    </div>

    <div class="panel">
        <div class="panel-header">
            <span class="panel-title">Listado de usuarios</span>
            <span class="record-count">@users.Count registros</span>
        </div>

        @if (users.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-people"></i>
                <span>No hay usuarios registrados</span>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Nombre</th>
                            <th>Usuario</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Creado</th>
                            <th>Actualizado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users)
                        {
                            <tr>
                                <td class="col-id">@user.IdUser</td>
                                <td class="col-name">@user.Name</td>
                                <td>@user.Username</td>
                                <td>
                                    <span class="badge-role">@(user.Role?.Name ?? "Sin rol")</span>
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge-active">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge-inactive">Inactivo</span>
                                    }
                                </td>
                                <td class="col-date">@user.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="col-date">@user.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="col-actions">
                                    <button class="action-btn btn-edit" @onclick="() => OpenEdit(user)" title="Editar">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (showModal)
{
    <div class="modal-backdrop" @onclick="CloseModal"></div>
    <div class="modal-box">
        <div class="modal-header">
            <span class="modal-title">@(isEditing ? "Editar usuario" : "Nuevo usuario")</span>
            <button class="modal-close" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
        </div>

        <div class="modal-body">
            <div class="form-group">
                <label class="form-label">Nombre completo <span class="required">*</span></label>
                <div class="input-box">
                    <i class="bi bi-person-fill input-icon"></i>
                    <input class="form-input" type="text" placeholder="Ej: Janneth Simbaña"
                           @bind="formName" @bind:event="oninput" />
                </div>
                @if (showValidation && string.IsNullOrWhiteSpace(formName))
                {
                    <span class="field-error">El nombre es requerido.</span>
                }
            </div>

            <div class="form-group">
                <label class="form-label">Usuario <span class="required">*</span></label>
                <div class="input-box">
                    <i class="bi bi-person-badge input-icon"></i>
                    <input class="form-input" type="text" placeholder="Ej: janneth.simbana"
                           @bind="formUserName" @bind:event="oninput" />
                </div>
                @if (showValidation && string.IsNullOrWhiteSpace(formUserName))
                {
                    <span class="field-error">El usuario es requerido.</span>
                }
            </div>

            <div class="form-group">
                <label class="form-label">
                    Contraseña
                    @if (!isEditing)
                    {
                        <span class="required">*</span>
                    }
                </label>
                <div class="input-box">
                    <i class="bi bi-shield-lock-fill input-icon"></i>
                    <input class="form-input" type="@(showPassword ? "text" : "password")"
                           placeholder="@(isEditing ? "Dejar vacío para mantener la actual" : "Mínimo 6 caracteres")"
                           @bind="formPassword" @bind:event="oninput" />
                    <button type="button" class="btn-eye" @onclick="() => showPassword = !showPassword">
                        <i class="bi @(showPassword ? "bi-eye-slash-fill" : "bi-eye-fill")"></i>
                    </button>
                </div>
                @if (showValidation && !isEditing && string.IsNullOrWhiteSpace(formPassword))
                {
                    <span class="field-error">La contraseña es requerida.</span>
                }
                else if (showValidation && formPassword.Trim().Length < 6)
                {
                    <span class="field-error">La contraseña debe tener al menos 6 caracteres.</span>
                }
            </div>

            <div class="form-group">
                <label class="form-label">Rol <span class="required">*</span></label>
                <div class="input-box">
                    <i class="bi bi-shield-check input-icon"></i>
                    <select class="form-input" @bind="formIdRole">
                        <option value="0">Seleccione un rol</option>
                        @foreach (var role in roles)
                        {
                            <option value="@role.IdRole">@role.Name</option>
                        }
                    </select>
                </div>
                @if (showValidation && formIdRole == 0)
                {
                    <span class="field-error">El rol es requerido.</span>
                }
            </div>

            <div class="form-group toggle-group">
                <label class="form-label">Estado</label>
                <label class="toggle-switch">
                    <input type="checkbox" @bind="formIsActive" />
                    <span class="toggle-label">@(formIsActive ? "Activo" : "Inactivo")</span>
                </label>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert-error">@errorMessage</div>
            }
        </div>

        <div class="modal-footer">
            <button class="btn-cancel" @onclick="CloseModal">Cancelar</button>
            <button class="btn-save" @onclick="Save" disabled="@isSaving">
                @if (isSaving)
                {
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Guardar</span>
                }
            </button>
        </div>
    </div>
}

@code {
    private List<User> users = new();
    private List<RoleModel> roles = new();

    private bool showModal;
    private bool isSaving;
    private bool showValidation;
    private bool showPassword;
    private bool isEditing;

    private string formName = string.Empty;
    private string formUserName = string.Empty;
    private string formPassword = string.Empty;
    private int formIdRole;
    private bool formIsActive = true;

    private User? selectedUser;
    private string errorMessage = string.Empty;

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        try
        {
            users = UserRepo.GetUsers().ToList();
            roles = RoleRepo.GetRoles().OrderBy(r => r.Name).ToList();
        }
        catch
        {
            errorMessage = "No se pudieron cargar los usuarios.";
        }
    }

    private void OpenCreate()
    {
        isEditing = false;
        selectedUser = null;
        formName = string.Empty;
        formUserName = string.Empty;
        formPassword = string.Empty;
        formIdRole = 0;
        formIsActive = true;
        errorMessage = string.Empty;
        showValidation = false;
        showPassword = false;
        showModal = true;
    }

    private void OpenEdit(User user)
    {
        isEditing = true;
        selectedUser = user;
        formName = user.Name ?? string.Empty;
        formUserName = user.Username ?? string.Empty;
        formPassword = string.Empty;
        formIdRole = user.IdRole ?? 0;
        formIsActive = user.IsActive;
        errorMessage = string.Empty;
        showValidation = false;
        showPassword = false;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        isSaving = false;
        showValidation = false;
        errorMessage = string.Empty;
    }

    private async Task Save()
    {
        showValidation = true;
        errorMessage = string.Empty;

        var password = formPassword.Trim();

        if (string.IsNullOrWhiteSpace(formName)
            || string.IsNullOrWhiteSpace(formUserName)
            || formIdRole == 0)
        {
            return;
        }

        // Al crear la contraseña es obligatoria; al editar, vacía significa "mantener la actual"
        if (!isEditing && string.IsNullOrWhiteSpace(password))
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(password) && password.Length < 6)
        {
            return;
        }

        var userName = formUserName.Trim();
        var usernameChanged = !isEditing
            || !string.Equals(selectedUser?.Username, userName, StringComparison.OrdinalIgnoreCase);

        if (usernameChanged && !UserRepo.IsUniqueUser(userName))
        {
            errorMessage = $"Ya existe un usuario con el nombre \"{userName}\".";
            return;
        }

        isSaving = true;

        try
        {
            if (isEditing && selectedUser != null)
            {
                await UserRepo.UpdateUser(selectedUser.IdUser, new UpdateUserDto
                {
                    UserName = userName,
                    Name = formName.Trim(),
                    Password = string.IsNullOrWhiteSpace(password) ? null : password,
                    IdRole = formIdRole,
                    IsActive = formIsActive
                });
            }
            else
            {
                await UserRepo.Register(new CreateUserDto
                {
                    UserName = userName,
                    Name = formName.Trim(),
                    Password = password,
                    IdRole = formIdRole
                });
            }

            LoadData();
            CloseModal();
        }
        catch
        {
            errorMessage = "Ocurrió un error al guardar el usuario. Intenta nuevamente.";
            isSaving = false;
        }
    }
}
