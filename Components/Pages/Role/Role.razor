@page "/roles"
@layout MainLayout
@rendermode InteractiveServer
@using Inventory_Flow.Models
@using Inventory_Flow.Models.Dtos
@using Inventory_Flow.Repository.IRepository
@using RoleModel = Inventory_Flow.Models.Role
@inject IRoleRepository RoleRepo

<div class="page-container">
    <div class="page-header">
        <div>
            <h1 class="title">Roles</h1>
            <p class="subtitle">Gestión de roles y permisos del sistema</p>
        </div>
        <button class="btn-primary" @onclick="OpenCreate">
            <i class="bi bi-plus-lg"></i>
            Nuevo rol
        </button>
    </div>

    <div class="panel">
        <div class="panel-header">
            <span class="panel-title">Listado de roles</span>
            <span class="record-count">@roles.Count registros</span>
        </div>

        @if (roles.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-shield-lock"></i>
                <span>No hay roles registrados</span>
            </div>
        }
        else
        {
            <div class="table-wrapper">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th>Creado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in roles)
                        {
                            <tr>
                                <td class="col-id">@r.IdRole</td>
                                <td class="col-name">@r.Name</td>
                                <td class="col-address">@r.Description</td>
                                <td class="col-date">@r.CreateDate.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                <td class="col-actions">
                                    <button class="action-btn btn-edit" @onclick="() => OpenEdit(r)" title="Editar">
                                        <i class="bi bi-pencil-fill"></i>
                                    </button>
                                    <button class="action-btn btn-delete" @onclick="() => OpenDelete(r)" title="Eliminar">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (showModal)
{
    <div class="modal-backdrop" @onclick="CloseModal"></div>
    <div class="modal-box">
        <div class="modal-header">
            <span class="modal-title">@(isEditing ? "Editar rol" : "Nuevo rol")</span>
            <button class="modal-close" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label class="form-label">Nombre <span class="required">*</span></label>
                <div class="input-box">
                    <i class="bi bi-shield-lock input-icon"></i>
                    <input class="form-input" type="text" placeholder="Ej: Administrador, Vendedor"
                           @bind="formName" @bind:event="oninput" />
                </div>
                @if (showValidation && string.IsNullOrWhiteSpace(formName))
                {
                    <span class="field-error">El nombre es requerido.</span>
                }
            </div>

            <div class="form-group">
                <label class="form-label">Descripción</label>
                <div class="input-box">
                    <i class="bi bi-card-text input-icon"></i>
                    <input class="form-input" type="text" placeholder="Descripción de permisos"
                           @bind="formDescription" @bind:event="oninput" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert-error">@errorMessage</div>
            }
        </div>
        <div class="modal-footer">
            <button class="btn-cancel" @onclick="CloseModal">Cancelar</button>
            <button class="btn-save" @onclick="Save" disabled="@isSaving">
                @if (isSaving)
                {
                    <span>Guardando...</span>
                }
                else
                {
                    <span>Guardar</span>
                }
            </button>
        </div>
    </div>
}

@if (showDeleteModal)
{
    <div class="modal-backdrop" @onclick="CloseModal"></div>
    <div class="modal-box modal-sm">
        <div class="modal-header">
            <span class="modal-title">Confirmar eliminación</span>
            <button class="modal-close" @onclick="CloseModal"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="modal-body">
            <p class="delete-msg">¿Deseas eliminar el rol <strong>@selectedRole?.Name</strong>? Esta acción no se puede deshacer.</p>
        </div>
        <div class="modal-footer">
            <button class="btn-cancel" @onclick="CloseModal">Cancelar</button>
            <button class="btn-danger" @onclick="ConfirmDelete" disabled="@isSaving">
                @if (isSaving) { <span>Eliminando...</span> } else { <span>Eliminar</span> }
            </button>
        </div>
    </div>
}

@code {
    private List<RoleModel> roles = new();

    private bool showModal;
    private bool showDeleteModal;
    private bool isEditing;
    private bool isSaving;
    private bool showValidation;

    private string formName = string.Empty;
    private string formDescription = string.Empty;
    private string errorMessage = string.Empty;

    private RoleModel? selectedRole;

    protected override void OnInitialized()
    {
        LoadRoles();
    }

    private void LoadRoles()
    {
        try
        {
            roles = RoleRepo.GetRoles().ToList();
        }
        catch
        {
            errorMessage = "No se pudieron cargar los roles.";
        }
    }

    private void OpenCreate()
    {
        formName = string.Empty;
        formDescription = string.Empty;
        errorMessage = string.Empty;
        showValidation = false;
        isEditing = false;
        selectedRole = null;
        showModal = true;
    }

    private void OpenEdit(RoleModel r)
    {
        selectedRole = r;
        formName = r.Name ?? string.Empty;
        formDescription = r.Description ?? string.Empty;
        errorMessage = string.Empty;
        showValidation = false;
        isEditing = true;
        showModal = true;
    }

    private void OpenDelete(RoleModel r)
    {
        selectedRole = r;
        showDeleteModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        showDeleteModal = false;
        isSaving = false;
        errorMessage = string.Empty;
    }

    private async Task Save()
    {
        showValidation = true;

        if (string.IsNullOrWhiteSpace(formName))
            return;

        isSaving = true;
        errorMessage = string.Empty;

        try
        {
            var dto = new CreateRoleDto
            {
                Name = formName.Trim(),
                Description = string.IsNullOrWhiteSpace(formDescription) ? null : formDescription.Trim()
            };

            if (isEditing && selectedRole != null)
            {
                await RoleRepo.UpdateRole(selectedRole.IdRole, dto);
            }
            else
            {
                await RoleRepo.CreateRole(dto);
            }

            LoadRoles();
            CloseModal();
        }
        catch
        {
            errorMessage = "Ocurrió un error al guardar. Intenta nuevamente.";
            isSaving = false;
        }
    }

    private void ConfirmDelete()
    {
        if (selectedRole == null) return;

        isSaving = true;
        try
        {
            RoleRepo.DeleteRole(selectedRole.IdRole);
            LoadRoles();
            CloseModal();
        }
        catch
        {
            errorMessage = "No se pudo eliminar el rol.";
            isSaving = false;
        }
    }
}
