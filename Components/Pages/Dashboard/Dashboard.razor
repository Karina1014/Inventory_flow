@page "/dashboard"
@layout MainLayout
@using Inventory_Flow.Models.Dtos
@using Inventory_Flow.Repository.IRepository
@inject IDashboardRepository DashboardRepo
@inject NavigationManager NavigationManager
@inject Inventory_Flow.Services.CurrentUserService CurrentUserService

<div class="dashboard-container">
    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <span>Calculando métricas del inventario...</span>
        </div>
    }
    else
    {
        <!-- 1. Encabezado de bienvenida (compacto) -->
        <div class="welcome-banner">
            <div class="banner-content">
                <h1 class="banner-greeting">@GreetingText, @(CurrentUserService.Name) 👋</h1>
                <p class="banner-subtitle">Resumen de inventario, movimientos y stock de hoy.</p>
            </div>

            <div class="banner-actions">
                <button class="btn-banner btn-banner-white" @onclick='() => NavigationManager.NavigateTo("products")'>
                    <i class="bi bi-box-seam"></i> Ver productos
                </button>
                <button class="btn-banner btn-banner-ghost" @onclick='() => NavigationManager.NavigateTo("movements")'>
                    <i class="bi bi-arrow-left-right"></i> Registrar movimiento
                </button>
            </div>
        </div>

        <!-- 2. Tarjetas de Indicadores Principales (KPIs) -->
        <div class="kpi-grid">
            <!-- Valor Total del Inventario -->
            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-icon icon-blue">
                        <i class="bi bi-wallet2"></i>
                    </div>
                </div>
                <div class="kpi-body">
                    <span class="kpi-title">Valor total del inventario</span>
                    <span class="kpi-value">$ @metrics.TotalInventoryValue.ToString("N2")</span>
                    <span class="kpi-hint">Valorizado a precio sugerido</span>
                </div>
            </div>

            <!-- Movimientos de Hoy -->
            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-icon icon-green">
                        <i class="bi bi-arrow-left-right"></i>
                    </div>
                </div>
                <div class="kpi-body">
                    <span class="kpi-title">Movimientos hoy</span>
                    <span class="kpi-value">@metrics.TodayMovementsCount</span>
                    <span class="kpi-hint">Registrados en la fecha</span>
                </div>
            </div>

            <!-- Sucursales y Lotes -->
            <div class="kpi-card">
                <div class="kpi-header">
                    <div class="kpi-icon icon-cyan">
                        <i class="bi bi-building"></i>
                    </div>
                </div>
                <div class="kpi-body">
                    <span class="kpi-title">Sucursales y Lotes</span>
                    <span class="kpi-value">@metrics.ActiveWarehousesCount sucursales</span>
                    <span class="kpi-hint">@metrics.TotalLotsCount lotes activos</span>
                </div>
            </div>

            <!-- Productos Bajo Stock -->
            <div class="kpi-card @(metrics.LowStockProductsCount > 0 ? "kpi-card-alert" : "")">
                <div class="kpi-header">
                    <div class="kpi-icon icon-red">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                    <a href="thresholds" class="kpi-config-btn" title="Configurar umbral de stock">
                        <i class="bi bi-gear-fill"></i>
                    </a>
                </div>
                <div class="kpi-body">
                    <span class="kpi-title">Productos bajo stock</span>
                    <span class="kpi-value text-danger">@metrics.LowStockProductsCount</span>
                    <div class="kpi-alert-bar">
                        <div class="kpi-alert-fill" style="width: @(metrics.LowStockProductsCount > 0 ? "100%" : "0%")"></div>
                    </div>
                    <span class="kpi-hint kpi-hint-threshold">
                        <i class="bi bi-sliders"></i> Umbral activo: @metrics.ActiveThreshold unidades
                    </span>
                    <div class="kpi-footer-links">
                        <a href="lots" class="kpi-link-alert">Revisar reposición &rarr;</a>
                        <a href="thresholds" class="kpi-link-config">Ajustar umbral</a>
                    </div>
                </div>
            </div>

            <!-- Lotes por Caducar -->
            <div class="kpi-card @(metrics.ExpiringLotsCount > 0 || metrics.ExpiredLotsCount > 0 ? "kpi-card-warning" : "")">
                <div class="kpi-header">
                    <div class="kpi-icon icon-amber">
                        <i class="bi bi-calendar-x"></i>
                    </div>
                </div>
                <div class="kpi-body">
                    <span class="kpi-title">Lotes por caducar</span>
                    <span class="kpi-value @(metrics.ExpiringLotsCount > 0 ? "text-warning-emphasis" : "")">@metrics.ExpiringLotsCount</span>
                    <span class="kpi-hint">Próximos @metrics.ExpirationAlertDays días</span>
                    <div class="kpi-footer-links">
                        <a href="lots" class="kpi-link-warning">Ver lotes &rarr;</a>
                        <span class="kpi-hint">@metrics.ExpiredLotsCount vencidos</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Lotes próximos a caducar -->
        <div class="panel-card">
            <div class="panel-card-header">
                <div class="panel-header-title">
                    <i class="bi bi-calendar-x text-danger"></i>
                    <span>Próximos a caducar</span>
                    <span class="category-threshold-note">
                        Ventana: <strong>@metrics.ExpirationAlertDays</strong> días
                    </span>
                </div>
            </div>
            <div class="panel-card-body">
                @if (metrics.ExpiringSoonLots.Count == 0)
                {
                    <div class="empty-analytics">
                        <i class="bi bi-check2-circle"></i>
                        <span>No hay lotes próximos a caducar en los siguientes @metrics.ExpirationAlertDays días</span>
                    </div>
                }
                else
                {
                    <div class="expiry-list">
                        @foreach (var lot in metrics.ExpiringSoonLots)
                        {
                            <div class="expiry-item @(lot.DaysToExpire < 0 ? "expiry-item-expired" : "")">
                                <div class="expiry-icon @(lot.DaysToExpire < 0 ? "expiry-icon-expired" : "expiry-icon-soon")">
                                    <i class="bi @(lot.DaysToExpire < 0 ? "bi-x-octagon-fill" : "bi-hourglass-split")"></i>
                                </div>
                                <div class="expiry-info">
                                    <div class="expiry-title">
                                        <strong>@lot.ProductName</strong>
                                        <span class="expiry-lot">Lote @lot.LotNumber</span>
                                    </div>
                                    <span class="expiry-meta">
                                        @lot.WarehouseName · @lot.Quantity u. · vence @lot.ExpirationDate.ToString("dd/MM/yyyy")
                                    </span>
                                </div>
                                <span class="expiry-days @(lot.DaysToExpire < 0 ? "expiry-days-expired" : "")">
                                    @GetExpiryLabel(lot.DaysToExpire)
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- 3. Sección Inferior: Gráfico de Categorías y Actividad Reciente -->
        <div class="analytics-grid">
            <!-- Stock por Categoría -->
            <div class="panel-card">
                <div class="panel-card-header">
                    <div class="panel-header-title">
                        <i class="bi bi-bar-chart-fill text-primary"></i>
                        <span>Stock por categoría</span>
                        <span class="category-threshold-note">
                            Umbral activo: <strong>@metrics.ActiveThreshold</strong> u.
                        </span>
                    </div>
                </div>
                <div class="panel-card-body">
                    @if (metrics.StockByCategory.Count == 0)
                    {
                        <div class="empty-analytics">
                            <i class="bi bi-box"></i>
                            <span>No hay stock registrado en las categorías</span>
                        </div>
                    }
                    else
                    {
                        <div class="categories-list">
                            @foreach (var cat in metrics.StockByCategory)
                            {
                                <div class="category-row @(cat.IsLowStock ? "category-row-low" : string.Empty)">
                                    <div class="category-meta">
                                        <span class="category-name @(cat.IsLowStock ? "category-name-low" : string.Empty)">@cat.CategoryName</span>
                                        <span class="category-units @(cat.IsLowStock ? "category-units-low" : string.Empty)">
                                            @cat.TotalUnits.ToString("N0") unidades (@cat.Percentage%)
                                            @if (cat.IsLowStock)
                                            {
                                                <span class="category-low-tag">
                                                    <i class="bi bi-exclamation-triangle-fill"></i> bajo umbral
                                                </span>
                                            }
                                        </span>
                                    </div>
                                    <div class="progress-bar-bg @(cat.IsLowStock ? "progress-bar-bg-low" : string.Empty)">
                                        <div class="progress-bar-fill @(cat.IsLowStock ? "progress-bar-fill-low" : string.Empty)" style="width: @cat.Percentage%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Actividad Reciente -->
            <div class="panel-card">
                <div class="panel-card-header">
                    <div class="panel-header-title">
                        <i class="bi bi-clock-history text-primary"></i>
                        <span>Actividad reciente</span>
                    </div>
                </div>
                <div class="panel-card-body">
                    @if (metrics.RecentActivities.Count == 0)
                    {
                        <div class="empty-analytics">
                            <i class="bi bi-inbox"></i>
                            <span>No hay movimientos registrados recientemente</span>
                        </div>
                    }
                    else
                    {
                        <div class="activity-list">
                            @foreach (var act in metrics.RecentActivities)
                            {
                                <div class="activity-item">
                                    <div class="activity-icon-col">
                                        @if (act.MovementTypeMode == "E")
                                        {
                                            <span class="act-icon act-entry" title="Entrada"><i class="bi bi-arrow-down-left"></i></span>
                                        }
                                        else if (act.MovementTypeMode == "S")
                                        {
                                            <span class="act-icon act-exit" title="Salida"><i class="bi bi-arrow-up-right"></i></span>
                                        }
                                        else
                                        {
                                            <span class="act-icon act-transfer" title="Transferencia"><i class="bi bi-arrow-left-right"></i></span>
                                        }
                                    </div>
                                    <div class="activity-info">
                                        <div class="activity-desc">
                                            <strong>@act.Description</strong>
                                            @if (act.TotalItems > 0)
                                            {
                                                <span class="activity-badge">@act.TotalItems u.</span>
                                            }
                                        </div>
                                        <span class="activity-time">(@act.TimeAgo) · por @act.UserName</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private DashboardMetricsDto metrics = new();
    private bool isLoading = true;

    private static string GetExpiryLabel(int days) => days switch
    {
        < 0 => $"Vencido hace {Math.Abs(days)} d",
        0 => "Vence hoy",
        _ => $"En {days} d"
    };

    private string GreetingText
    {
        get
        {
            var hour = DateTime.Now.Hour;
            if (hour < 12) return "Buenos días";
            if (hour < 19) return "Buenas tardes";
            return "Buenas noches";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardMetrics();
    }

    private async Task LoadDashboardMetrics()
    {
        isLoading = true;
        try
        {
            metrics = await DashboardRepo.GetDashboardMetricsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar métricas: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
