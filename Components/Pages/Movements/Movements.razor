    private void AddDetailRow()
    {
        formDetails.Add(new CreateInventoryMovementDetailDto { Quantity = 1 });
    }

    private void RemoveDetailRow(CreateInventoryMovementDetailDto row)
    {
        if (formDetails.Count > 1)
            formDetails.Remove(row);
    }

    private async Task Save()
    {
        errorMessage = string.Empty;

        if (formMovementTypeId <= 0)
        {
            errorMessage = "Debe seleccionar un tipo de movimiento.";
            return;
        }

        var mode = CurrentMovementMode;
        if (mode == "E" && !formDestWarehouseId.HasValue)
        {
            errorMessage = "Para una entrada debe seleccionar el Almacén Destino.";
            return;
        }
        if (mode == "S" && !formOriginWarehouseId.HasValue)
        {
            errorMessage = "Para una salida debe seleccionar el Almacén Origen.";
            return;
        }
        if (mode == "T")
        {
            if (!formOriginWarehouseId.HasValue || !formDestWarehouseId.HasValue)
            {
                errorMessage = "Para una transferencia debe seleccionar ambos almacenes.";
                return;
            }
            if (formOriginWarehouseId == formDestWarehouseId)
            {
                errorMessage = "El almacén origen y destino no pueden ser el mismo.";
                return;
            }
        }

        isSaving = true;
        try
        {
            if (isEditing && selectedMovement != null)
            {
                var dto = new UpdateInventoryMovementDto
                {
                    Observation = formObservation.Trim(),
                    ReferenceId = formReferenceId,
                    ReferenceSource = formReferenceSource?.Trim()
                };
                await MovementRepo.UpdateMovementAsync(selectedMovement.IdInventoryMovement, dto);
            }
            else
            {
                if (formDetails.Count == 0 || formDetails.Any(d => d.IdProduct <= 0 || d.Quantity <= 0))
                {
                    errorMessage = "Cada línea debe tener un producto seleccionado y cantidad mayor a 0.";
                    isSaving = false;
                    return;
                }

                // Validación de stock para salidas o transferencias
                if (mode == "S" || mode == "T")
                {
                    foreach (var det in formDetails)
                    {
                        if (det.IdLot.HasValue && det.Quantity > det.AvailableStock)
                        {
                            errorMessage = $"La cantidad ({det.Quantity}) supera el stock disponible ({det.AvailableStock}) del lote seleccionado.";
                            isSaving = false;
                            return;
                        }
                    }
                }

                var dto = new CreateInventoryMovementDto
                {
                    MovementDate = formDate,
                    IdMovementType = formMovementTypeId,
                    IdOriginWarehouse = formOriginWarehouseId,
                    IdDestinationWarehouse = formDestWarehouseId,
                    Observation = formObservation.Trim(),
                    ReferenceId = formReferenceId,
                    ReferenceSource = formReferenceSource?.Trim(),
                    Details = formDetails
                };
                await MovementRepo.CreateMovementAsync(dto);
            }

            await LoadData();
            CloseModal();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ConfirmDelete()
    {
        if (selectedMovement == null) return;

        isSaving = true;
        try
        {
            await MovementRepo.DeleteMovementAsync(selectedMovement.IdInventoryMovement);
            await LoadData();
            CloseModal();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
