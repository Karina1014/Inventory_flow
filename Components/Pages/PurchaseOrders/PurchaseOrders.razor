}

<!-- ==================== MODAL: RECEPCIONAR MERCADERÍA (LOTES Y FEFO) ==================== -->
@if (showReceiveModal && selectedOrder != null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-dialog-custom modal-dialog-lg" style="max-width: 900px;">
            <div class="modal-header-custom">
                <div class="d-flex align-items-center gap-2">
                    <div class="header-icon-box text-success" style="width:36px; height:36px; font-size:1.1rem; background-color:#D1FAE5;">
                        <i class="bi bi-box-arrow-in-down"></i>
                    </div>
                    <div>
                        <h5 class="mb-0 fw-bold text-dark">Recepción Física de Mercadería (Ingreso con Lotes)</h5>
                        <span class="text-muted small">Orden N° @selectedOrder.OrderNumber · Destino: @(selectedOrder.DestinationWarehouse?.Name ?? "Matriz")</span>
                    </div>
                </div>
                <button type="button" class="btn-close" @onclick="CloseModals"></button>
            </div>

            <div class="modal-body-custom">
                @if (!string.IsNullOrWhiteSpace(receiveErrorMessage))
                {
                    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>@receiveErrorMessage</span>
                    </div>
                }

                <!-- Datos de la Entrega -->
                <div class="row g-2 mb-3 p-2 bg-light rounded border">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-muted mb-1">N° Guía de Remisión o Factura Proveedor</label>
                        <input type="text" class="form-control form-control-flat"
                               placeholder="Ej: 001-002-0001248"
                               @bind="receiveDto.DeliveryNoteNumber" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold text-muted mb-1">Notas de Control de Calidad / Recepción</label>
                        <input type="text" class="form-control form-control-flat"
                               placeholder="Ej: Embalaje en perfecto estado, cadena de frío verificada"
                               @bind="receiveDto.ReceptionNotes" />
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold mb-0 text-dark">Ítems Pendientes por Ingresar</h6>
                    <span class="text-muted small">Ingrese la cantidad recibida, código de lote y fecha de vencimiento del fabricante.</span>
                </div>

                @if (receiveDto.Items.Count == 0)
                {
                    <div class="alert alert-info py-2">
                        Todos los productos de esta orden ya han sido recibidos completamente.
                    </div>
                }
                else
                {
                    <div class="table-responsive border rounded">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="text-muted small">
                                    <th>Producto</th>
                                    <th class="text-center" style="width: 80px;">Pedido</th>
                                    <th class="text-center" style="width: 80px;">Pendiente</th>
                                    <th style="width: 120px;">Cant. Recibir</th>
                                    <th style="width: 160px;">N° Lote Fabricante *</th>
                                    <th style="width: 150px;">Fecha Caducidad *</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in receiveDto.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold text-dark">@item.ProductName</div>
                                            <span class="text-muted font-monospace small">@item.ProductCode</span>
                                        </td>
                                        <td class="text-center font-monospace">@item.OrderedQuantity</td>
                                        <td class="text-center font-monospace fw-bold text-primary">@item.RemainingQuantity</td>
                                        <td>
                                            <input type="number" class="form-control form-control-sm text-center font-monospace"
                                                   min="0" max="@item.RemainingQuantity"
                                                   @bind="item.QuantityToReceive" />
                                        </td>
                                        <td>
                                            <input type="text" class="form-control form-control-sm text-uppercase"
                                                   placeholder="Ej: L2611-001"
                                                   disabled="@(item.QuantityToReceive == 0)"
                                                   @bind="item.LotNumber" />
                                        </td>
                                        <td>
                                            <input type="date" class="form-control form-control-sm"
                                                   disabled="@(item.QuantityToReceive == 0)"
                                                   @bind="item.ExpirationDate" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="modal-footer-custom">
                <button type="button" class="btn btn-flat-secondary" @onclick="CloseModals">Cancelar</button>
                <button type="button"
                        class="btn btn-success"
                        disabled="@(isReceiving || receiveDto.Items.Count == 0 || !receiveDto.Items.Any(i => i.QuantityToReceive > 0))"
                        @onclick="ConfirmReceiveOrderAsync">
                    @if (isReceiving)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Ingresando a Inventario...</span>
                    }
                    else
                    {
                        <i class="bi bi-box-seam me-1"></i>
                        <span>Confirmar e Ingresar a Bodega</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private const string TabOrders = "orders";
    private const string TabFinancial = "financial";

    private string activeTab = TabOrders;

    // Catálogos
    private ICollection<PurchaseOrderStatus> statuses = new List<PurchaseOrderStatus>();
    private ICollection<PurchaseOrderType> types = new List<PurchaseOrderType>();
    private ICollection<Supplier> suppliers = new List<Supplier>();
    private ICollection<Warehouse> warehouses = new List<Warehouse>();
    private ICollection<Product> availableProducts = new List<Product>();

    // Paginación y Listado Tab 1
    private PagedResultDto<PurchaseOrder> pagedOrders = new();
    private int currentPage = 1;
    private const int PageSize = 10;
    private bool isLoading = true;

    // Filtros
    private string searchTerm = string.Empty;
    private int filterSupplierId = 0;
    private int filterStatusId = 0;
    private int filterTypeId = 0;

    // Tab 2: Aprobación Financiera
    private List<PurchaseOrder> financialPendingOrders = new();
    private int pendingFinancialCount = 0;
    private bool isLoadingFinancial = false;

    // Modales
    private bool showCreateModal = false;
    private bool showDetailModal = false;
    private bool showApprovalModal = false;
    private bool showCancelModal = false;
    private bool showReceiveModal = false;

    private ReceivePurchaseOrderDto receiveDto = new();
    private string receiveErrorMessage = string.Empty;
    private bool isReceiving = false;

    private PurchaseOrder? selectedOrder;

    // Formulario Crear
    private int newSupplierId = 0;
    private int newTypeId = 1;
    private int newWarehouseId = 0;
    private DateTime? newExpectedDate;
    private string newObservation = string.Empty;
    private string createErrorMessage = string.Empty;
    private bool isSubmitting = false;

    // Ítems de la orden en borrador
    private int selectedProductId = 0;
    private int inputQuantity = 1;
    private decimal inputUnitPrice = 0;
    private decimal inputTaxPct = 15;
    private List<CreatePurchaseOrderDetailDto> draftDetails = new();

    // Acciones de Aprobación
    private bool isApprovingAction = true;
    private string approvalNote = string.Empty;
    private bool isSubmittingApproval = false;

    // Cancelar
    private string cancelReason = string.Empty;

    // Totales calculados en borrador
    private decimal DraftSubtotal => draftDetails.Sum(d => Math.Round(d.Quantity * d.UnitPrice, 2));
    private decimal DraftTaxAmount => draftDetails.Sum(d => Math.Round(Math.Round(d.Quantity * d.UnitPrice, 2) * (d.TaxPercentage / 100m), 2));
    private decimal DraftTotalAmount => DraftSubtotal + DraftTaxAmount;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadCatalogsAsync();
            await LoadOrdersAsync();
            await LoadFinancialPendingOrdersAsync();
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error inicializando módulo: {ex.Message}", "Error");
            isLoading = false;
            isLoadingFinancial = false;
        }
    }

    private async Task LoadCatalogsAsync()
    {
        try
        {
            statuses = await CatalogRepo.GetStatusesAsync();
            types = await CatalogRepo.GetTypesAsync(activeOnly: true);
            suppliers = SupplierRepo.GetSuppliers().Where(s => s.IsActive).OrderBy(s => s.CompanyName).ToList();
            warehouses = WarehouseRepo.GetWarehouses().Where(w => w.IsActive).OrderBy(w => w.Name).ToList();
            availableProducts = ProductRepo.GetProducts().Where(p => p.IsActive).OrderBy(p => p.Name).ToList();

            // Bodega matriz por defecto
            var matriz = warehouses.FirstOrDefault(w => w.Name.Contains("Carapungo", StringComparison.OrdinalIgnoreCase)
                                                     || w.Name.Contains("Matriz", StringComparison.OrdinalIgnoreCase)
                                                     || w.Name.Contains("Principal", StringComparison.OrdinalIgnoreCase)
                                                     || (w.Address != null && w.Address.Contains("Carapungo", StringComparison.OrdinalIgnoreCase)));
            newWarehouseId = matriz?.IdWarehouse ?? (warehouses.FirstOrDefault()?.IdWarehouse ?? 0);
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error al cargar catálogos de compra: {ex.Message}", "Catálogos");
        }
    }

    private async Task LoadOrdersAsync()
    {
        isLoading = true;
        try
        {
            pagedOrders = await OrderRepo.GetOrdersPagedAsync(
                pageNumber: currentPage,
                pageSize: PageSize,
                supplierId: filterSupplierId > 0 ? filterSupplierId : null,
                statusId: filterStatusId > 0 ? filterStatusId : null,
                orderTypeId: filterTypeId > 0 ? filterTypeId : null,
                search: string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm.Trim());
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error al consultar órdenes: {ex.Message}", "Base de Datos");
            pagedOrders = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadFinancialPendingOrdersAsync()
    {
        isLoadingFinancial = true;
        try
        {
            // Id 2 = Pendiente Aprobación Financiera
            var result = await OrderRepo.GetOrdersPagedAsync(
                pageNumber: 1,
                pageSize: 100,
                pendingFinancialOnly: true);

            financialPendingOrders = result.Items.ToList();
            pendingFinancialCount = result.TotalCount;
        }
        catch (Exception ex)
        {
            ToastService.Error($"Error al consultar órdenes financieras: {ex.Message}", "Finanzas");
            financialPendingOrders = new();
            pendingFinancialCount = 0;
        }
        finally
        {
            isLoadingFinancial = false;
        }
    }

    private async Task SwitchTab(string tab)
    {
        activeTab = tab;
        if (tab == TabOrders)
        {
            await LoadOrdersAsync();
        }
        else
        {
            await LoadFinancialPendingOrdersAsync();
        }
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            currentPage = 1;
            await LoadOrdersAsync();
        }
    }

    private async Task ResetFilters()
    {
        searchTerm = string.Empty;
        filterSupplierId = 0;
        filterStatusId = 0;
        filterTypeId = 0;
        currentPage = 1;
        await LoadOrdersAsync();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > pagedOrders.TotalPages) return;
        currentPage = page;
        await LoadOrdersAsync();
    }

    private void OpenCreateModal()
    {
        newSupplierId = 0;
        newTypeId = types.FirstOrDefault()?.IdPurchaseOrderType ?? 1;
        newExpectedDate = DateTime.Now.AddDays(3);
        newObservation = string.Empty;
        createErrorMessage = string.Empty;
        selectedProductId = 0;
        inputQuantity = 1;
        inputUnitPrice = 0;
        inputTaxPct = 15;
        draftDetails.Clear();
        showCreateModal = true;
    }

    private void OnSupplierSelected()
    {
        var sup = suppliers.FirstOrDefault(s => s.IdSupplier == newSupplierId);
        if (sup != null)
        {
            newExpectedDate = DateTime.Now.AddDays(Math.Max(1, sup.DeliveryLeadTimeDays));
        }
    }

    private void AddProductToDraft()
    {
        createErrorMessage = string.Empty;
        if (selectedProductId <= 0)
        {
            createErrorMessage = "Seleccione un producto para agregar.";
            return;
        }
        if (inputQuantity <= 0)
        {
            createErrorMessage = "La cantidad debe ser mayor a 0.";
            return;
        }
        if (inputUnitPrice < 0)
        {
            createErrorMessage = "El precio unitario no puede ser negativo.";
            return;
        }

        var existing = draftDetails.FirstOrDefault(d => d.IdProduct == selectedProductId);
        if (existing != null)
        {
            existing.Quantity += inputQuantity;
            existing.UnitPrice = inputUnitPrice > 0 ? inputUnitPrice : existing.UnitPrice;
            existing.TaxPercentage = inputTaxPct;
        }
        else
        {
            draftDetails.Add(new CreatePurchaseOrderDetailDto
            {
                IdProduct = selectedProductId,
                Quantity = inputQuantity,
                UnitPrice = inputUnitPrice,
                TaxPercentage = inputTaxPct
            });
        }

        selectedProductId = 0;
        inputQuantity = 1;
        inputUnitPrice = 0;
    }

    private void RemoveDraftDetail(CreatePurchaseOrderDetailDto item)
    {
        draftDetails.Remove(item);
    }

    private async Task SubmitCreateOrderAsync()
    {
        createErrorMessage = string.Empty;
        if (newSupplierId <= 0)
        {
            createErrorMessage = "Debe seleccionar un proveedor para la orden de compra.";
            return;
        }
        if (!draftDetails.Any())
        {
            createErrorMessage = "Debe agregar al menos un producto a la orden.";
            return;
        }

        isSubmitting = true;
        try
        {
            var dto = new CreatePurchaseOrderDto
            {
                IdSupplier = newSupplierId,
                IdPurchaseOrderType = newTypeId,
                IdDestinationWarehouse = newWarehouseId,
                ExpectedDeliveryDate = newExpectedDate,
                Observation = newObservation,
                Details = draftDetails
            };

            var userId = CurrentUserService.UserId > 0 ? CurrentUserService.UserId : 1;
            var created = await OrderRepo.CreateOrderAsync(dto, userId);

            ToastService.Success($"Orden de compra {created.OrderNumber} enviada a Finanzas correctamente.");
            CloseModals();
            await LoadOrdersAsync();
            await LoadFinancialPendingOrdersAsync();
        }
        catch (Exception ex)
        {
            createErrorMessage = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task OpenDetailModal(PurchaseOrder order)
    {
        selectedOrder = await OrderRepo.GetOrderByIdAsync(order.IdPurchaseOrder) ?? order;
        showDetailModal = true;
    }

    private void OpenApprovalModal(PurchaseOrder order, bool approved)
    {
        selectedOrder = order;
        isApprovingAction = approved;
        approvalNote = string.Empty;
        showApprovalModal = true;
    }

    private async Task SubmitFinancialApprovalAsync()
    {
        if (selectedOrder == null) return;

        if (!isApprovingAction && string.IsNullOrWhiteSpace(approvalNote))
        {
            ToastService.Warning("Debe ingresar una observación explicando el motivo del rechazo.");
            return;
        }

        isSubmittingApproval = true;
        try
        {
            var userId = CurrentUserService.UserId > 0 ? CurrentUserService.UserId : 1;
            var success = await OrderRepo.ProcessFinancialApprovalAsync(
                selectedOrder.IdPurchaseOrder, isApprovingAction, userId, approvalNote);

            if (success)
            {
                var msg = isApprovingAction
                    ? $"Presupuesto de la orden {selectedOrder.OrderNumber} APROBADO."
                    : $"Orden {selectedOrder.OrderNumber} RECHAZADA por Finanzas.";
                ToastService.Success(msg);
                CloseModals();
                await LoadOrdersAsync();
                await LoadFinancialPendingOrdersAsync();
            }
        }
        catch (Exception ex)
        {
            ToastService.Error(ex.Message, "Error en Resolución Financiera");
        }
        finally
        {
            isSubmittingApproval = false;
        }
    }

    private void OpenCancelModal(PurchaseOrder order)
    {
        selectedOrder = order;
        cancelReason = string.Empty;
        showCancelModal = true;
    }

    private async Task SubmitCancelOrderAsync()
    {
        if (selectedOrder == null || string.IsNullOrWhiteSpace(cancelReason)) return;

        isSubmitting = true;
        try
        {
            var userId = CurrentUserService.UserId > 0 ? CurrentUserService.UserId : 1;
            var success = await OrderRepo.CancelOrderAsync(selectedOrder.IdPurchaseOrder, userId, cancelReason);
            if (success)
            {
                ToastService.Success($"Orden {selectedOrder.OrderNumber} anulada correctamente.");
                CloseModals();
                await LoadOrdersAsync();
                await LoadFinancialPendingOrdersAsync();
            }
        }
        catch (Exception ex)
        {
            ToastService.Error(ex.Message, "Error al anular orden");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private bool CanReceive(PurchaseOrder? order)
    {
        if (order?.PurchaseOrderStatus == null) return false;
        var code = order.PurchaseOrderStatus.Code;
        return code == "APROBADO_FINANCIERO" || code == "EMITIDO_PROVEEDOR" || code == "RECIBIDO_PARCIAL";
    }

    private void OpenReceiveModal(PurchaseOrder order)
    {
        selectedOrder = order;
        receiveErrorMessage = string.Empty;
        receiveDto = new ReceivePurchaseOrderDto
        {
            IdPurchaseOrder = order.IdPurchaseOrder,
            DeliveryNoteNumber = string.Empty,
            ReceptionNotes = string.Empty,
            Items = order.Details.Select(d => new ReceivePurchaseOrderItemDto
            {
                IdPurchaseOrderDetail = d.IdPurchaseOrderDetail,
                IdProduct = d.IdProduct,
                ProductCode = d.Product?.Code ?? "-",
                ProductName = d.Product?.Name ?? "Producto",
                OrderedQuantity = d.Quantity,
                PreviouslyReceivedQuantity = d.ReceivedQuantity,
                QuantityToReceive = Math.Max(0, d.Quantity - d.ReceivedQuantity),
                LotNumber = string.Empty,
                ExpirationDate = DateTime.Today.AddMonths(18)
            }).Where(i => i.RemainingQuantity > 0).ToList()
        };
        showReceiveModal = true;
    }

    private async Task ConfirmReceiveOrderAsync()
    {
        if (selectedOrder == null) return;

        var itemsToReceive = receiveDto.Items.Where(i => i.QuantityToReceive > 0).ToList();
        if (!itemsToReceive.Any())
        {
            receiveErrorMessage = "Debe ingresar una cantidad a recibir mayor a 0 en al menos un producto.";
            return;
        }

        foreach (var item in itemsToReceive)
        {
            if (string.IsNullOrWhiteSpace(item.LotNumber))
            {
                receiveErrorMessage = $"Debe ingresar el número de lote del fabricante para el producto '{item.ProductName}'.";
                return;
            }

            if (item.ExpirationDate <= DateTime.Today)
            {
                receiveErrorMessage = $"La fecha de caducidad del lote '{item.LotNumber}' ({item.ExpirationDate:dd/MM/yyyy}) debe ser posterior a la fecha actual.";
                return;
            }

            if (item.QuantityToReceive > item.RemainingQuantity)
            {
                receiveErrorMessage = $"La cantidad a recibir de '{item.ProductName}' ({item.QuantityToReceive}) supera la cantidad pendiente ({item.RemainingQuantity}).";
                return;
            }
        }

        isReceiving = true;
        receiveErrorMessage = string.Empty;

        try
        {
            var userId = CurrentUserService.UserId > 0 ? CurrentUserService.UserId : 1;
            var success = await OrderRepo.ReceiveOrderShipmentAsync(receiveDto, userId);
            if (success)
            {
                ToastService.Success($"Recepción de la Orden #{selectedOrder.OrderNumber} registrada exitosamente. Lotes y stock ingresados en {selectedOrder.DestinationWarehouse?.Name}.");
                CloseModals();
                await LoadOrdersAsync();
                await LoadFinancialPendingOrdersAsync();
            }
        }
        catch (Exception ex)
        {
            receiveErrorMessage = ex.Message;
        }
        finally
        {
            isReceiving = false;
        }
    }

    private async Task OpenPdf(int idPurchaseOrder)
    {
        if (idPurchaseOrder <= 0) return;
        var url = $"/api/purchaseorders/{idPurchaseOrder}/pdf";
        await JSRuntime.InvokeVoidAsync("open", url, "_blank");
    }

    private void CloseModals()
    {
        showCreateModal = false;
        showDetailModal = false;
        showApprovalModal = false;
        showCancelModal = false;
        showReceiveModal = false;
        selectedOrder = null;
        createErrorMessage = string.Empty;
        receiveErrorMessage = string.Empty;
    }
}
