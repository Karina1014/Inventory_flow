@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject Inventory_Flow.Services.CurrentUserService CurrentUserService
@implements IDisposable

<div class="app-layout">
    <aside class="sidebar">
        <div class="brand">
            <span class="brand-title">MedVet</span>
            <span class="brand-subtitle">Inventario</span>
        </div>

        <nav class="nav-links">
            <NavLink class="nav-item" href="dashboard" Match="NavLinkMatch.All">
                <i class="bi bi-grid-fill"></i>
                <span>Dashboard</span>
            </NavLink>

            <details class="nav-group" open>
                <summary class="nav-group-title">
                    <span>Administración</span>
                    <i class="bi bi-chevron-down nav-group-chevron"></i>
                </summary>

                <div class="nav-submenu">
                    <NavLink class="nav-item nav-subitem" href="warehouses">
                        <i class="bi bi-building"></i>
                        <span>Sucursales</span>
                    </NavLink>

                    <NavLink class="nav-item nav-subitem" href="categories">
                        <i class="bi bi-tags-fill"></i>
                        <span>Categorías</span>
                    </NavLink>

                    <NavLink class="nav-item nav-subitem" href="products">
                        <i class="bi bi-box-seam"></i>
                        <span>Productos</span>
                    </NavLink>

                    <NavLink class="nav-item nav-subitem" href="movementtypes">
                        <i class="bi bi-arrow-left-right"></i>
                        <span>Tipos de movimientos</span>
                    </NavLink>

                    <NavLink class="nav-item nav-subitem" href="roles">
                        <i class="bi bi-shield-lock-fill"></i>
                        <span>Roles</span>
                    </NavLink>

                    <NavLink class="nav-item nav-subitem" href="users">
                        <i class="bi bi-people-fill"></i>
                        <span>Usuarios</span>
                    </NavLink>

                    <NavLink class="nav-item nav-subitem" href="thresholds">
                        <i class="bi bi-sliders"></i>
                        <span>Umbral de Stock</span>
                    </NavLink>
                    <NavLink class="nav-item nav-subitem" href="lots">
                        <i class="bi bi-boxes"></i>
                        <span>Lotes</span>
                    </NavLink>
                </div>
            </details>

            <details class="nav-group" open>
                <summary class="nav-group-title">
                    <span>Operaciones</span>
                    <i class="bi bi-chevron-down nav-group-chevron"></i>
                </summary>

                <div class="nav-submenu">
                    <NavLink class="nav-item nav-subitem" href="movements">
                        <i class="bi bi-arrow-left-right"></i>
                        <span>Movimientos</span>
                    </NavLink>

                    <NavLink class="nav-item nav-subitem" href="analytics">
                        <i class="bi bi-stars"></i>
                        <span>Análisis IA</span>
                    </NavLink>
                </div>
            </details>

            <details class="nav-group" open>
                <summary class="nav-group-title">
                    <span>Reportes</span>
                    <i class="bi bi-chevron-down nav-group-chevron"></i>
                </summary>
                    <div class="nav-submenu">
                    <NavLink class="nav-item nav-subitem" href="stockreport">
                        <i class="bi bi-clipboard-data"></i>
                        <span>Reporte de stock</span>
                    </NavLink>

                    <NavLink class="nav-item nav-subitem" href="kardex">
                        <i class="bi bi-journal-text"></i>
                        <span>Kardex</span>
                    </NavLink>
                  </div>
            </details>

            <NavLink class="nav-item mt-2" href="profile">
                <i class="bi bi-person-circle"></i>
                <span>Mi Perfil</span>
            </NavLink>
        </nav>

        <div class="sidebar-footer">
            © @DateTime.Now.Year Universidad Central del Ecuador
            <span>Derechos de autor reservados</span>
        </div>
    </aside>

    <div class="main-wrapper">
        <header class="topbar">
            <div class="topbar-left">
                <span class="page-title">Panel de Control</span>
            </div>

            <div class="topbar-right">
                <div class="user-dropdown-container position-relative">
                    <!-- Solo el Círculo de Usuario con indicador de estado -->
                    <button type="button" class="topbar-avatar-btn" @onclick="ToggleDropdown" aria-label="Menú de usuario" style="width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, #0077b6 0%, #033f63 100%); color: #ffffff; border: 2px solid #ffffff; display: flex; align-items: center; justify-content: center; font-size: 0.84rem; font-weight: 700; box-shadow: 0 2px 6px rgba(0, 119, 182, 0.25); cursor: pointer; padding: 0; outline: none; position: relative;">
                        @(GetInitials(CurrentUserService.Name))
                        <span class="avatar-status-dot" style="position: absolute; bottom: -1px; right: -1px; width: 10px; height: 10px; border-radius: 50%; background-color: #22c55e; border: 2px solid #ffffff;"></span>
                    </button>

                    @if (isDropdownOpen)
                    {
                        <!-- Telón transparente para cerrar al hacer clic afuera -->
                        <div class="dropdown-backdrop" @onclick="CloseDropdown" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 1040; background: transparent;"></div>

                        <!-- Submenú Desplegable Flotante Estilizado con Bootstrap y CSS -->
                        <div class="user-menu-dropdown dropdown-menu show shadow-lg border" style="position: absolute; right: 0; top: calc(100% + 8px); min-width: 220px; z-index: 1050; border-radius: 12px; padding: 0.5rem 0; overflow: hidden; background: #ffffff;">
                            <div class="px-3 py-2 bg-light border-bottom mb-1">
                                <div class="fw-bold text-dark text-truncate" style="font-size: 0.88rem;">@CurrentUserService.Name</div>
                                <div class="d-flex align-items-center gap-1 mt-1">
                                    <span class="online-dot"></span>
                                    <span class="text-muted fw-semibold" style="font-size: 0.74rem;">@GetRoleLabel(CurrentUserService.Role)</span>
                                </div>
                            </div>

                            <NavLink href="profile" class="dropdown-item d-flex align-items-center gap-2 py-2 px-3 text-dark text-decoration-none" @onclick="CloseDropdown">
                                <i class="bi bi-person-circle fs-6 text-primary"></i>
                                <span style="font-size: 0.85rem; font-weight: 500;">Mi Perfil</span>
                            </NavLink>

                            <hr class="dropdown-divider my-1 opacity-25" />

                            <button type="button" class="dropdown-item d-flex align-items-center gap-2 py-2 px-3 text-danger border-0 bg-transparent w-100 text-start" @onclick="Logout">
                                <i class="bi bi-box-arrow-right fs-6"></i>
                                <span style="font-size: 0.85rem; font-weight: 500;">Cerrar sesión</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </header>

        <main class="content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool isDropdownOpen;

    private void ToggleDropdown() => isDropdownOpen = !isDropdownOpen;
    private void CloseDropdown() => isDropdownOpen = false;

    protected override void OnInitialized()
    {
        CurrentUserService.OnChange += StateHasChanged;

        // Redirigir al login si el usuario no está autenticado
        if (!CurrentUserService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login", replace: true);
        }
    }

    private void Logout()
    {
        isDropdownOpen = false;
        CurrentUserService.Clear();
        NavigationManager.NavigateTo("/login");
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "??";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}";
        }
        return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }

    private string GetRoleLabel(string role) => role switch
    {
        "Admin"    => "Administrador",
        "AppUser"  => "Usuario",
        _          => string.IsNullOrWhiteSpace(role) ? "Sin rol" : role
    };

    public void Dispose()
    {
        CurrentUserService.OnChange -= StateHasChanged;
    }
}
