@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject Inventory_Flow.Services.CurrentUserService CurrentUserService
@inject Inventory_Flow.Repository.IRepository.IMenuRepository MenuRepo
@inject Inventory_Flow.Services.IToastNotificationService ToastService
@using Inventory_Flow.Models.Dtos
@implements IDisposable

<ToastContainer />

<div class="layout-container">
    <!-- Sidebar Izquierdo Fijo (260px) con fondo gris claro #F8FAFC y borde fino #E2E8F0 -->
    <aside class="sidebar">
        <!-- Logotipo Arriba -->
        <div class="sidebar-brand">
            <div class="brand-icon">
                <i class="bi bi-box-seam-fill"></i>
            </div>
            <div class="brand-text">
                <span class="brand-title">Inventory Flow</span>
                <span class="brand-subtitle">MedVet Enterprise</span>
            </div>
        </div>

        <!-- Enlaces de Navegación -->
        <nav class="sidebar-nav">
            <!-- 1. Enlace Raíz Principal: Dashboard -->
            <NavLink class="nav-item-link" href="dashboard" Match="NavLinkMatch.All">
                <i class="bi bi-grid-1x2"></i>
                <span>Dashboard</span>
            </NavLink>

            <!-- 2. Enlace a Nuevo Módulo: Control de Inventario -->
            <NavLink class="nav-item-link" href="inventario">
                <i class="bi bi-boxes"></i>
                <span>Control de Inventario</span>
            </NavLink>

            @if (userMenus != null && userMenus.Any())
            {
                @* Menús dinámicos cargados según el rol del usuario *@

                @* Enlaces raíz adicionales sin categoría *@
                @foreach (var item in userMenus.Where(m => string.IsNullOrWhiteSpace(m.Category) && !IsDefaultRoot(m.Url)))
                {
                    <NavLink class="nav-item-link" href="@item.Url.TrimStart('/')">
                        <i class="@item.Icon"></i>
                        <span>@item.Name</span>
                    </NavLink>
                }

                @* Grupos por categoría (Operaciones, Administración, Reportes, etc.) *@
                @foreach (var group in userMenus.Where(m => !string.IsNullOrWhiteSpace(m.Category)).GroupBy(m => m.Category))
                {
                    var catKey = group.Key!;
                    var isOpen = IsCategoryOpen(catKey);

                    <div class="nav-group">
                        <button type="button" class="nav-item-link nav-group-toggle" @onclick="() => ToggleCategory(catKey)">
                            <div class="d-flex align-items-center gap-2">
                                <i class="@GetCategoryIcon(catKey)"></i>
                                <span>@FormatCategoryTitle(catKey)</span>
                            </div>
                            <i class="bi @(isOpen ? "bi-chevron-up" : "bi-chevron-down") chevron-indicator"></i>
                        </button>

                        @if (isOpen)
                        {
                            <div class="submenu">
                                @foreach (var sub in group)
                                {
                                    <NavLink class="submenu-link" href="@sub.Url.TrimStart('/')">
                                        <i class="@sub.Icon"></i>
                                        <span>@sub.Name</span>
                                    </NavLink>
                                }
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                @* Estructura completa predeterminada con todas las categorías *@

                <!-- GRUPO: OPERACIONES -->
                <div class="nav-group">
                    <button type="button" class="nav-item-link nav-group-toggle" @onclick='() => ToggleCategory("Operaciones")'>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-arrow-left-right"></i>
                            <span>Operaciones</span>
                        </div>
                        <i class="bi @(IsCategoryOpen("Operaciones") ? "bi-chevron-up" : "bi-chevron-down") chevron-indicator"></i>
                    </button>

                    @if (IsCategoryOpen("Operaciones"))
                    {
                        <div class="submenu">
                            <NavLink class="submenu-link" href="movements">
                                <i class="bi bi-arrow-left-right"></i>
                                <span>Movimientos</span>
                            </NavLink>
                            <NavLink class="submenu-link" href="analytics">
                                <i class="bi bi-graph-up"></i>
                                <span>Análisis IA</span>
                            </NavLink>
                        </div>
                    }
                </div>

                <!-- GRUPO: ADMINISTRACIÓN -->
                <div class="nav-group">
                    <button type="button" class="nav-item-link nav-group-toggle" @onclick='() => ToggleCategory("Administración")'>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-sliders"></i>
                            <span>Administración</span>
                        </div>
                        <i class="bi @(IsCategoryOpen("Administración") ? "bi-chevron-up" : "bi-chevron-down") chevron-indicator"></i>
                    </button>

                    @if (IsCategoryOpen("Administración"))
                    {
                        <div class="submenu">
                            <NavLink class="submenu-link" href="products">
                                <i class="bi bi-box-seam"></i>
                                <span>Productos</span>
                            </NavLink>
                            <NavLink class="submenu-link" href="lots">
                                <i class="bi bi-upc-scan"></i>
                                <span>Control de Lotes</span>
                            </NavLink>
                            <NavLink class="submenu-link" href="categories">
                                <i class="bi bi-tags"></i>
                                <span>Categorías</span>
                            </NavLink>
                            <NavLink class="submenu-link" href="warehouses">
                                <i class="bi bi-building"></i>
                                <span>Sucursales</span>
                            </NavLink>
                            <NavLink class="submenu-link" href="movementtypes">
                                <i class="bi bi-diagram-3"></i>
                                <span>Tipos de Movimientos</span>
                            </NavLink>
                            <NavLink class="submenu-link" href="thresholds">
                                <i class="bi bi-speedometer2"></i>
                                <span>Umbral de Stock</span>
                            </NavLink>
                            <NavLink class="submenu-link" href="users">
                                <i class="bi bi-people"></i>
                                <span>Usuarios</span>
                            </NavLink>
                            <NavLink class="submenu-link" href="roles">
                                <i class="bi bi-person-badge"></i>
                                <span>Roles</span>
                            </NavLink>
                        </div>
                    }
                </div>

                <!-- GRUPO: REPORTES -->
                <div class="nav-group">
                    <button type="button" class="nav-item-link nav-group-toggle" @onclick='() => ToggleCategory("Reportes")'>
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-file-earmark-bar-graph"></i>
                            <span>Reportes</span>
                        </div>
                        <i class="bi @(IsCategoryOpen("Reportes") ? "bi-chevron-up" : "bi-chevron-down") chevron-indicator"></i>
                    </button>

                    @if (IsCategoryOpen("Reportes"))
                    {
                        <div class="submenu">
                            <NavLink class="submenu-link" href="stockreport">
                                <i class="bi bi-bar-chart"></i>
                                <span>Reporte de Stock</span>
                            </NavLink>
                            <NavLink class="submenu-link" href="kardex">
                                <i class="bi bi-journal-text"></i>
                                <span>Kardex</span>
                            </NavLink>
                        </div>
                    }
                </div>
            }

            <!-- Módulo Mi Perfil -->
            <NavLink class="nav-item-link mt-2" href="profile">
                <i class="bi bi-person-circle"></i>
                <span>Mi Perfil</span>
            </NavLink>
        </nav>

        <!-- Pie del Menú Lateral -->
        <div class="sidebar-footer">
            <span class="text-muted small">&copy; @DateTime.Now.Year Universidad Central del Ecuador</span>
        </div>
    </aside>

    <!-- Contenedor Principal (Topbar + Contenido) -->
    <div class="main-wrapper">
        <!-- Topbar Fija (60px) -->
        <header class="topbar">
            <!-- Barra de búsqueda minimalista con insignia Ctrl K a la izquierda -->
            <div class="search-box">
                <i class="bi bi-search search-icon"></i>
                <input type="text" class="search-input" placeholder="Buscar productos, lotes o SKU..." />
                <kbd class="search-kbd">Ctrl K</kbd>
            </div>

            <!-- Avatar de usuario circular a la derecha -->
            <div class="topbar-actions">
                <div class="user-dropdown-container position-relative">
                    <button type="button" class="topbar-avatar-btn" @onclick="ToggleDropdown" aria-label="Menú de usuario">
                        <span>@(GetInitials(CurrentUserService.Name))</span>
                        <span class="avatar-status-dot"></span>
                    </button>

                    @if (isDropdownOpen)
                    {
                        <div class="dropdown-backdrop" @onclick="CloseDropdown"></div>

                        <div class="user-menu-dropdown">
                            <div class="user-menu-header">
                                <div class="user-menu-name">@(string.IsNullOrWhiteSpace(CurrentUserService.Name) ? "Usuario" : CurrentUserService.Name)</div>
                                <div class="user-menu-status">
                                    <span class="online-dot"></span>
                                    <span class="user-menu-role">@GetRoleLabel(CurrentUserService.Role)</span>
                                </div>
                            </div>

                            <div class="user-menu-divider"></div>

                            <NavLink href="profile" class="user-menu-item" @onclick="CloseDropdown">
                                <i class="bi bi-person-circle"></i>
                                <span>Mi Perfil</span>
                            </NavLink>

                            <div class="user-menu-divider"></div>

                            <button type="button" class="user-menu-item logout-item" @onclick="Logout">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Cerrar sesión</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </header>

        <!-- Contenido de las Páginas -->
        <main class="page-content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool isDropdownOpen;
    private List<MenuDto> userMenus = new();

    // Gestión de estados de categorías abiertas en C#
    private HashSet<string> openCategories = new(StringComparer.OrdinalIgnoreCase)
    {
        "Operaciones",
        "Administración",
        "Reportes"
    };

    private bool IsCategoryOpen(string category) => openCategories.Contains(category);

    private void ToggleCategory(string category)
    {
        if (openCategories.Contains(category))
        {
            openCategories.Remove(category);
        }
        else
        {
            openCategories.Add(category);
        }
    }

    private void ToggleDropdown() => isDropdownOpen = !isDropdownOpen;
    private void CloseDropdown() => isDropdownOpen = false;

    private bool IsDefaultRoot(string url)
    {
        var clean = "/" + url.Trim('/');
        return clean.Equals("/dashboard", StringComparison.OrdinalIgnoreCase) 
            || clean.Equals("/inventario", StringComparison.OrdinalIgnoreCase)
            || clean.Equals("/profile", StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync()
    {
        CurrentUserService.OnChange += HandleUserChanged;

        if (!CurrentUserService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login", replace: true);
            return;
        }

        await LoadMenusAsync();
        ValidateRouteAccess();
    }

    protected override void OnParametersSet()
    {
        ValidateRouteAccess();
    }

    private void HandleUserChanged()
    {
        InvokeAsync(async () =>
        {
            await LoadMenusAsync();
            ValidateRouteAccess();
            StateHasChanged();
        });
    }

    private async Task LoadMenusAsync()
    {
        if (CurrentUserService.IsAuthenticated)
        {
            try
            {
                var menus = await MenuRepo.GetMenusByUserId(CurrentUserService.UserId);
                userMenus = menus?.ToList() ?? new();
            }
            catch
            {
                userMenus = new();
            }
        }
        else
        {
            userMenus = new();
        }
    }

    private void ValidateRouteAccess()
    {
        if (!CurrentUserService.IsAuthenticated)
        {
            return;
        }

        var relativePath = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?')[0].Trim('/');
        if (string.Equals(relativePath, "/dashboard", StringComparison.OrdinalIgnoreCase)
            || string.Equals(relativePath, "/profile", StringComparison.OrdinalIgnoreCase)
            || string.Equals(relativePath, "/login", StringComparison.OrdinalIgnoreCase)
            || string.Equals(relativePath, "/inventario", StringComparison.OrdinalIgnoreCase)
            || string.Equals(relativePath, "/", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        if (userMenus != null && userMenus.Count > 0)
        {
            var hasAccess = userMenus.Any(m => string.Equals("/" + m.Url.Trim('/'), relativePath, StringComparison.OrdinalIgnoreCase));
            if (!hasAccess)
            {
                ToastService.Warning("No tienes permisos para acceder a este módulo.", "Acceso restringido");
                NavigationManager.NavigateTo("/dashboard", replace: true);
            }
        }
    }

    private void Logout()
    {
        isDropdownOpen = false;
        CurrentUserService.Clear();
        userMenus.Clear();
        NavigationManager.NavigateTo("/login");
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "KG";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}";
        }
        return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }

    private string GetRoleLabel(string role) => string.IsNullOrWhiteSpace(role) ? "Administrador" : role;

    private string FormatCategoryTitle(string? cat)
    {
        if (string.IsNullOrWhiteSpace(cat)) return string.Empty;
        var lower = cat.Trim().ToLowerInvariant();
        if (lower == "administracion" || lower == "administración") return "Administración";
        if (lower == "operaciones") return "Operaciones";
        if (lower == "reportes") return "Reportes";
        return char.ToUpper(lower[0]) + lower.Substring(1);
    }

    private string GetCategoryIcon(string? cat)
    {
        var lower = cat?.Trim().ToLowerInvariant() ?? "";
        if (lower.Contains("admin")) return "bi bi-sliders";
        if (lower.Contains("operac") || lower.Contains("movim")) return "bi bi-arrow-left-right";
        if (lower.Contains("report") || lower.Contains("analis")) return "bi bi-file-earmark-bar-graph";
        return "bi bi-folder2";
    }

    public void Dispose()
    {
        CurrentUserService.OnChange -= HandleUserChanged;
    }
}
