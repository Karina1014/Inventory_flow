@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject Inventory_Flow.Services.CurrentUserService CurrentUserService
@implements IDisposable

<div class="app-layout">
    <aside class="sidebar">
        <div class="brand">
            <span class="brand-title">MedVet</span>
            <span class="brand-subtitle">Inventario</span>
        </div>

        <nav class="nav-links">
            <NavLink class="nav-item" href="dashboard" Match="NavLinkMatch.All">
                <i class="bi bi-grid-fill"></i>
                <span>Dashboard</span>
            </NavLink>

            <details class="nav-group" open>
                <summary class="nav-group-title">
                    <span>Administración</span>
                    <i class="bi bi-chevron-down nav-group-chevron"></i>
                </summary>

                <div class="nav-submenu">
                    <NavLink class="nav-item nav-subitem" href="warehouses">
                        <i class="bi bi-building"></i>
                        <span>Sucursales</span>
                    </NavLink>

                    <NavLink class="nav-item nav-subitem" href="categories">
                        <i class="bi bi-tags-fill"></i>
                        <span>Categorías</span>
                    </NavLink>

                    <NavLink class="nav-item nav-subitem" href="products">
                        <i class="bi bi-box-seam"></i>
                        <span>Productos</span>
                    </NavLink>

                    <NavLink class="nav-item nav-subitem" href="movementtypes">
                        <i class="bi bi-arrow-left-right"></i>
                        <span>Tipos de movimientos</span>
                    </NavLink>

                    <NavLink class="nav-item nav-subitem" href="roles">
                        <i class="bi bi-shield-lock-fill"></i>
                        <span>Roles</span>
                    </NavLink>

                    <NavLink class="nav-item nav-subitem" href="thresholds">
                        <i class="bi bi-sliders"></i>
                        <span>Umbral de Stock</span>
                    </NavLink>
                    <NavLink class="nav-item nav-subitem" href="lots">
                        <i class="bi bi-boxes"></i>
                        <span>Lotes</span>
                    </NavLink>
                </div>
            </details>

            <details class="nav-group" open>
                <summary class="nav-group-title">
                    <span>Operaciones</span>
                    <i class="bi bi-chevron-down nav-group-chevron"></i>
                </summary>

                <div class="nav-submenu">
                    <NavLink class="nav-item nav-subitem" href="movements">
                        <i class="bi bi-arrow-left-right"></i>
                        <span>Movimientos</span>
                    </NavLink>

                    <NavLink class="nav-item nav-subitem" href="analytics">
                        <i class="bi bi-stars"></i>
                        <span>Análisis IA</span>
                    </NavLink>
                </div>
            </details>

            <details class="nav-group" open>
                <summary class="nav-group-title">
                    <span>Reportes</span>
                    <i class="bi bi-chevron-down nav-group-chevron"></i>
                </summary>
                    <div class="nav-submenu">
                    <NavLink class="nav-item nav-subitem" href="stockreport">
                        <i class="bi bi-clipboard-data"></i>
                        <span>Reporte de stock</span>
                    </NavLink>

                    <NavLink class="nav-item nav-subitem" href="kardex">
                        <i class="bi bi-journal-text"></i>
                        <span>Kardex</span>
                    </NavLink>
                  </div>
            </details>
        </nav>
    </aside>

    <div class="main-wrapper">
        <header class="topbar">
            <div class="topbar-left">
                <span class="page-title">Panel de Control</span>
            </div>

            <div class="topbar-right">
                <!-- Tarjeta de Usuario estilizada con clases estándar -->
                <div class="user-profile-badge">
                    <div class="user-avatar-circle">
                        @(GetInitials(CurrentUserService.Name))
                    </div>
                    <div class="user-text-meta">
                        <span class="user-display-name">@CurrentUserService.Name</span>
                        <div class="user-status-line">
                            <span class="online-dot"></span>
                            <span class="user-role-label">@GetRoleLabel(CurrentUserService.Role)</span>
                        </div>
                    </div>
                </div>

                <div class="header-v-divider"></div>

                <!-- Botón Salir Corporativo -->
                <button type="button" class="btn-logout-header" @onclick="Logout" title="Cerrar sesión">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Salir</span>
                </button>
            </div>
        </header>

        <main class="content">
            @Body
        </main>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        CurrentUserService.OnChange += StateHasChanged;

        // Redirigir al login si el usuario no está autenticado
        if (!CurrentUserService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login", replace: true);
        }
    }

    private void Logout()
    {
        CurrentUserService.Clear();
        NavigationManager.NavigateTo("/login");
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "??";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}";
        }
        return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }

    private string GetRoleLabel(string role) => role switch
    {
        "Admin"    => "Administrador",
        "AppUser"  => "Usuario",
        _          => string.IsNullOrWhiteSpace(role) ? "Sin rol" : role
    };

    public void Dispose()
    {
        CurrentUserService.OnChange -= StateHasChanged;
    }
}
