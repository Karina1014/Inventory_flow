@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject Inventory_Flow.Services.CurrentUserService CurrentUserService
@inject Inventory_Flow.Repository.IRepository.IMenuRepository MenuRepo
@inject Inventory_Flow.Services.IToastNotificationService ToastService
@inject IJSRuntime JSRuntime
@using Inventory_Flow.Models.Dtos
@implements IDisposable

<ToastContainer />

<div class="layout-container @(isSidebarOpen ? "sidebar-mobile-open" : "")">
    <!-- Overlay oscurecedor para cerrar el menú en móviles -->
    @if (isSidebarOpen)
    {
        <div class="sidebar-backdrop" @onclick="CloseSidebar"></div>
    }

    <!-- Sidebar Izquierdo Fijo (260px) con fondo gris claro #F8FAFC y borde #E2E8F0 -->
    <aside class="sidebar">
        <!-- Encabezado superior con Logotipo y Título -->
        <div class="sidebar-brand">
            <div class="brand-icon">
                <i class="bi bi-box-seam-fill"></i>
            </div>
            <div class="brand-text">
                <span class="brand-title">Inventory Flow</span>
                <span class="brand-subtitle">MEDVET ENTERPRISE</span>
            </div>
            <!-- Botón para cerrar menú en móviles -->
            <button type="button" class="sidebar-close-btn" @onclick="CloseSidebar" aria-label="Cerrar menú">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <!-- Menú de Navegación Lateral Reorganizado -->
        <NavMenu />

        <!-- Pie del Menú Lateral -->
        <div class="sidebar-footer">
            <span class="text-muted small">&copy; 2026 Universidad Central del Ecuador</span>
        </div>
    </aside>

    <!-- Contenedor Principal (Topbar + Contenido) -->
    <div class="main-wrapper">
        <!-- Topbar Fija (60px) -->
        <header class="topbar">
            <div class="topbar-left">
                <!-- Botón Hamburguesa para móviles y pantallas compactas -->
                <button type="button" class="sidebar-toggle-btn" @onclick="ToggleSidebar" aria-label="Abrir menú" title="Menú de navegación">
                    <i class="bi bi-list"></i>
                </button>

                <!-- Barra de búsqueda minimalista con insignia Ctrl K a la izquierda -->
                <div class="search-box">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" class="search-input" placeholder="Buscar productos, lotes o SKU..." />
                    <kbd class="search-kbd">Ctrl K</kbd>
                </div>
            </div>

            <!-- Acciones de la barra superior: Selector de Tema + Avatar de usuario -->
            <div class="topbar-actions">
                <!-- Botón Modo Claro / Oscuro -->
                <button type="button"
                        class="theme-toggle-btn"
                        @onclick="ToggleThemeAsync"
                        title="@(isDarkMode ? "Cambiar a modo claro" : "Cambiar a modo oscuro")"
                        aria-label="Cambiar tema">
                    <i class="bi @(isDarkMode ? "bi-sun-fill text-warning" : "bi-moon-stars-fill")"></i>
                </button>

                <div class="user-dropdown-container position-relative">
                    <button type="button" class="topbar-avatar-btn" @onclick="ToggleDropdown" aria-label="Menú de usuario">
                        <span>@(GetInitials(CurrentUserService.Name))</span>
                        <span class="avatar-status-dot"></span>
                    </button>

                    @if (isDropdownOpen)
                    {
                        <div class="dropdown-backdrop" @onclick="CloseDropdown"></div>

                        <div class="user-menu-dropdown">
                            <div class="user-menu-header">
                                <div class="user-menu-name">@(string.IsNullOrWhiteSpace(CurrentUserService.Name) ? "Usuario" : CurrentUserService.Name)</div>
                                <div class="user-menu-status">
                                    <span class="online-dot"></span>
                                    <span class="user-menu-role">@GetRoleLabel(CurrentUserService.Role)</span>
                                </div>
                            </div>

                            <div class="user-menu-divider"></div>

                            <button type="button" class="user-menu-item" @onclick="ToggleThemeAsync">
                                <i class="bi @(isDarkMode ? "bi-sun-fill text-warning" : "bi-moon-stars-fill")"></i>
                                <span>@(isDarkMode ? "Modo Claro" : "Modo Oscuro")</span>
                            </button>

                            <NavLink href="profile" class="user-menu-item" @onclick="CloseDropdown">
                                <i class="bi bi-person-circle"></i>
                                <span>Mi Perfil</span>
                            </NavLink>

                            <div class="user-menu-divider"></div>

                            <button type="button" class="user-menu-item logout-item" @onclick="Logout">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Cerrar sesión</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </header>

        <!-- Contenido de las Páginas -->
        <main class="page-content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool isDropdownOpen;
    private bool isDarkMode;
    private bool isSidebarOpen;
    private List<MenuDto> userMenus = new();

    private void ToggleDropdown() => isDropdownOpen = !isDropdownOpen;
    private void CloseDropdown() => isDropdownOpen = false;
    private void ToggleSidebar() => isSidebarOpen = !isSidebarOpen;
    private void CloseSidebar() => isSidebarOpen = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JSRuntime.InvokeAsync<string>("eval", @"(function() {
                    var t = localStorage.getItem('medvet_theme') || document.documentElement.getAttribute('data-theme') || 'light';
                    document.documentElement.setAttribute('data-theme', t);
                    document.documentElement.setAttribute('data-bs-theme', t);
                    return t;
                })()");
                isDarkMode = string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase);
                StateHasChanged();
            }
            catch
            {
                // Ignorar en pre-rendering
            }
        }
    }

    private async Task ToggleThemeAsync()
    {
        try
        {
            var nextTheme = await JSRuntime.InvokeAsync<string>("eval", @"(function() {
                var current = document.documentElement.getAttribute('data-theme') || localStorage.getItem('medvet_theme') || 'light';
                var next = current === 'dark' ? 'light' : 'dark';
                localStorage.setItem('medvet_theme', next);
                document.documentElement.setAttribute('data-theme', next);
                document.documentElement.setAttribute('data-bs-theme', next);
                if (window.medvetTheme && typeof window.medvetTheme.setTheme === 'function') {
                    window.medvetTheme.setTheme(next);
                }
                return next;
            })()");
            isDarkMode = string.Equals(nextTheme, "dark", StringComparison.OrdinalIgnoreCase);
            StateHasChanged();
        }
        catch
        {
            isDarkMode = !isDarkMode;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        CurrentUserService.OnChange += HandleUserChanged;
        NavigationManager.LocationChanged += OnLocationChanged;

        if (!CurrentUserService.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login", replace: true);
            return;
        }

        await LoadMenusAsync();
        ValidateRouteAccess();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        isSidebarOpen = false;
        isDropdownOpen = false;
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        ValidateRouteAccess();
    }

    private void HandleUserChanged()
    {
        InvokeAsync(async () =>
        {
            userMenus.Clear();
            await LoadMenusAsync();
            ValidateRouteAccess();
            StateHasChanged();
        });
    }

    private async Task LoadMenusAsync()
    {
        if (userMenus != null && userMenus.Count > 0)
        {
            return;
        }

        if (CurrentUserService.IsAuthenticated)
        {
            try
            {
                var menus = await MenuRepo.GetMenusByUserId(CurrentUserService.UserId);
                userMenus = menus?.ToList() ?? new();
            }
            catch
            {
                userMenus = new();
            }
        }
        else
        {
            userMenus = new();
        }
    }

    private void ValidateRouteAccess()
    {
        if (!CurrentUserService.IsAuthenticated)
        {
            return;
        }

        var relativePath = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?')[0].Trim('/');
        if (string.Equals(relativePath, "/dashboard", StringComparison.OrdinalIgnoreCase)
            || string.Equals(relativePath, "/profile", StringComparison.OrdinalIgnoreCase)
            || string.Equals(relativePath, "/login", StringComparison.OrdinalIgnoreCase)
            || string.Equals(relativePath, "/inventario", StringComparison.OrdinalIgnoreCase)
            || string.Equals(relativePath, "/requisitions", StringComparison.OrdinalIgnoreCase)
            || string.Equals(relativePath, "/purchase-orders", StringComparison.OrdinalIgnoreCase)
            || string.Equals(relativePath, "/suppliers", StringComparison.OrdinalIgnoreCase)
            || string.Equals(relativePath, "/", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        if (userMenus != null && userMenus.Count > 0)
        {
            var hasAccess = userMenus.Any(m => string.Equals("/" + m.Url.Trim('/'), relativePath, StringComparison.OrdinalIgnoreCase));
            if (!hasAccess)
            {
                ToastService.Warning("No tienes permisos para acceder a este módulo.", "Acceso restringido");
                NavigationManager.NavigateTo("/dashboard", replace: true);
            }
        }
    }

    private void Logout()
    {
        isDropdownOpen = false;
        CurrentUserService.Clear();
        userMenus.Clear();
        NavigationManager.NavigateTo("/login");
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "KG";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[1][0])}";
        }
        return name.Substring(0, Math.Min(2, name.Length)).ToUpper();
    }

    private string GetRoleLabel(string role) => string.IsNullOrWhiteSpace(role) ? "Administrador" : role;

    public void Dispose()
    {
        CurrentUserService.OnChange -= HandleUserChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
