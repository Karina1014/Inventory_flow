@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<div class="app-layout">
    <aside class="sidebar">
        <div class="brand">
            <span class="brand-title">MedVet</span>
            <span class="brand-subtitle">Inventario</span>
        </div>

        <div class="user-box">
            <div class="avatar">
                <i class="bi bi-person-fill"></i>
            </div>
            <div class="user-meta">
                <span class="name">Karina Simbaña</span>
                <span class="role">Admin</span>
            </div>
        </div>

        <nav class="nav-links">
            <NavLink class="nav-item" href="dashboard" Match="NavLinkMatch.All">
                <i class="bi bi-grid-fill"></i>
                <span>Dashboard</span>
            </NavLink>

            <NavLink class="nav-item" href="roles">
                <i class="bi bi-shield-lock-fill"></i>
                <span>Roles</span>
            </NavLink>

            <NavLink class="nav-item" href="warehouses">
                <i class="bi bi-building"></i>
                <span>Almacenes</span>
            </NavLink>

            <NavLink class="nav-item" href="products">
                <i class="bi bi-box-seam"></i>
                <span>Productos</span>
            </NavLink>
        </nav>

        <div class="sidebar-bottom">
            <NavLink class="btn-logout" href="login">
                <i class="bi bi-box-arrow-right"></i>
                <span>Salir</span>
            </NavLink>
        </div>
    </aside>

    <div class="main-wrapper">
        <header class="topbar">
            <span class="page-title">Panel de Control</span>
            <div class="topbar-user">
                <span class="user-badge">En línea</span>
            </div>
        </header>

        <main class="content">
            @Body
        </main>
    </div>
</div>
